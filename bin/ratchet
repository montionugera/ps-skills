#!/usr/bin/env python3
"""ratchet: test ratchet enforcement tooling."""
from __future__ import annotations

import argparse
import difflib
import fnmatch
import hashlib
import json
import os
import secrets
import shlex
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def file_sha(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def gate_hash(root: Path, kind_cfg: dict) -> str:
    """sha256 over the check command text and the bytes of every gate file. Raises FileNotFoundError."""
    h = hashlib.sha256(kind_cfg["check_cmd"].encode())
    for rel in sorted(kind_cfg["gate_files"]):
        h.update(b"\0" + rel.encode() + b"\0" + (root / rel).read_bytes())
    return h.hexdigest()


def run_check(root: Path, ledger: Path, kind_cfg: dict, artifact: Path, input_path: Path, key: str) -> dict:
    """key = '<a12>.<g12>.<i12>'. Reuses checks/<key>.json only for PASS or FAIL; otherwise runs check_cmd with cwd=root."""
    rec_path = ledger / "checks" / f"{key}.json"
    if rec_path.is_file():
        rec = json.loads(rec_path.read_text())
        if rec.get("result") in ("PASS", "FAIL"):
            return rec
    out_path = ledger / "checks" / f"{key}.out.json"
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.unlink(missing_ok=True)
    subs = {"{artifact}": str(artifact), "{input}": str(input_path), "{out}": str(out_path), "{dir}": str(artifact.parent)}
    cmd = []
    for part in shlex.split(kind_cfg["check_cmd"]):
        for token, value in subs.items():
            part = part.replace(token, value)
        cmd.append(part)
    try:
        proc = subprocess.run(cmd, cwd=root, capture_output=True, text=True, timeout=300)
        code, tail = proc.returncode, (proc.stderr or proc.stdout)[-300:]
    except (OSError, subprocess.TimeoutExpired) as exc:
        code, tail = -1, str(exc)
    all_pass = None
    try:
        all_pass = json.loads(out_path.read_text()).get("all_pass")
    except (OSError, ValueError, AttributeError):
        pass
    if code == 0 and all_pass is True:
        result = "PASS"
    elif all_pass is False:
        result = "FAIL"
    else:
        result = "ERROR"
    rec = {"result": result, "exit": code, "detail": tail,
           "out": str(out_path.relative_to(ledger)) if out_path.is_file() else None}
    if result != "ERROR":
        rec_path.write_text(json.dumps(rec))
    return rec


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{secrets.token_hex(4)}.tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def find_root(start: Path) -> Path | None:
    """First parent holding .ratchet.json, else None."""
    cur = start.resolve()
    return next((p for p in [cur, *cur.parents] if (p / ".ratchet.json").is_file()), None)


def load(root: Path) -> tuple[dict, Path]:
    """(config, root / config['ledger']). Raises on a missing or corrupt file."""
    cfg = json.loads((root / ".ratchet.json").read_text())
    return cfg, root / cfg.get("ledger", "ratchet")


def classify(root: Path, cfg: dict, artifact: Path) -> tuple[str, dict] | None:
    """(kind name, kind cfg) or None."""
    try:
        rel = artifact.resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        return None
    for kind, kind_cfg in cfg["kinds"].items():
        if fnmatch.fnmatchcase(rel, kind_cfg["artifacts"]) and not any(
                fnmatch.fnmatchcase(rel, e) for e in kind_cfg.get("exclude", [])):
            return kind, kind_cfg
    return None


def input_of(kind_cfg: dict, artifact: Path) -> Path:
    """kind_cfg['input'] with {dir} replaced; may not exist."""
    return Path(kind_cfg["input"].replace("{dir}", str(artifact.resolve().parent))).resolve()


def slug_of(kind_cfg: dict, input_path: Path) -> str:
    """Raises KeyError when a slug field is missing."""
    data = json.loads(input_path.read_text())
    return "/".join(str(data[f]) for f in kind_cfg["slug_fields"])


def resolve(root: Path, cfg: dict, arg) -> tuple[Path, str, dict, Path, str]:
    """(artifact, kind, kind_cfg, input_path, slug). Raises ValueError with a reason."""
    artifact = Path(arg).resolve()
    if not artifact.is_file():
        raise ValueError(f"artifact missing: {artifact}")
    cls = classify(root, cfg, artifact)
    if cls is None:
        raise ValueError("path matches no kind or is excluded")
    kind, kind_cfg = cls
    input_path = input_of(kind_cfg, artifact)
    if not input_path.is_file():
        raise ValueError(f"input file missing: {input_path}")
    return artifact, kind, kind_cfg, input_path, slug_of(kind_cfg, input_path)


def read_jsonl(path: Path) -> list[dict]:
    """[] when the file is missing; raises ValueError on a line that is not JSON."""
    if not path.is_file():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def append_jsonl(path: Path, record: dict) -> None:
    """Creates parent folders; one json.dumps(record, ensure_ascii=False) line, one write call."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o666)
    try:
        os.write(fd, (json.dumps(record, ensure_ascii=False) + "\n").encode("utf-8"))
    finally:
        os.close(fd)


def newest_by(ledger: Path, field: str) -> dict[str, dict]:
    """Newest verdict per value of `field` (e.g. 'sha256' or 'path')."""
    newest: dict[str, dict] = {}
    for v in read_jsonl(ledger / "verdicts.jsonl"):
        key = v.get(field)
        if key and (key not in newest or v.get("ts", "") >= newest[key].get("ts", "")):
            newest[key] = v
    return newest


def read_baseline(ledger: Path) -> dict:
    """{} when absent; raises when present but unreadable. baseline.json is only a cache."""
    path = ledger / "baseline.json"
    return json.loads(path.read_text()) if path.is_file() else {}


def case_states(root: Path, cfg: dict, ledger: Path, only_kind: str | None = None, cached_only: bool = False) -> list[dict]:
    """One dict per cases/<sha256>/: kind, state, sha, caught, dir, data, bad.
    state: 'caught' (FAIL), 'blind' (PASS), 'error', or 'unknown' (cached_only and no cached PASS/FAIL).
    Each case is checked on its frozen copy. An unreadable case.json gives state 'error', bad=True, sha=folder name."""
    out: list[dict] = []
    hashes: dict[str, str] = {}
    cases_dir = ledger / "cases"
    for d in sorted(cases_dir.iterdir()) if cases_dir.is_dir() else []:
        if not (d / "case.json").is_file():
            continue
        try:
            data = json.loads((d / "case.json").read_text())
            kind, sha = data["kind"], data["sha256"]
        except (ValueError, KeyError, OSError):
            out.append({"kind": None, "state": "error", "sha": d.name, "caught": False, "dir": d, "data": {}, "bad": True})
            continue
        if only_kind and kind != only_kind:
            continue
        case = {"kind": kind, "state": "error", "sha": sha, "caught": data.get("caught") is True, "dir": d, "data": data, "bad": False}
        out.append(case)
        kind_cfg = cfg["kinds"].get(kind)
        art, inp = d / data.get("artifact", ""), d / data.get("input", "")
        if not kind_cfg or not art.is_file() or not inp.is_file():
            continue
        try:
            g = hashes[kind] = hashes.get(kind) or gate_hash(root, kind_cfg)
            key = f"{sha[:12]}.{g[:12]}.{file_sha(inp)[:12]}"
            rec_path = ledger / "checks" / f"{key}.json"
            if cached_only:
                rec = json.loads(rec_path.read_text()) if rec_path.is_file() else {}
                res = rec.get("result") if rec.get("result") in ("PASS", "FAIL") else "UNKNOWN"
            else:
                res = run_check(root, ledger, kind_cfg, art, inp, key)["result"]
            case["state"] = {"FAIL": "caught", "PASS": "blind", "UNKNOWN": "unknown"}.get(res, "error")
        except Exception:
            pass
    return out


def false_blocks(root: Path, cfg: dict, ledger: Path, only_kind: str | None) -> list[str]:
    """Paths whose newest verdict is 'satisfied', whose file still has that sha256, and whose check is not PASS."""
    found = []
    for p_str, v in newest_by(ledger, "path").items():
        if v.get("level") != "satisfied" or (only_kind and v.get("kind") != only_kind):
            continue
        p = Path(p_str)
        if not p.is_file() or file_sha(p) != v.get("sha256"):
            continue
        try:
            kind_cfg = cfg["kinds"][v["kind"]]
            inp = input_of(kind_cfg, p)
            key = f"{v['sha256'][:12]}.{gate_hash(root, kind_cfg)[:12]}.{file_sha(inp)[:12]}"
            ok = run_check(root, ledger, kind_cfg, p, inp, key)["result"] == "PASS"
        except Exception:
            ok = False
        if not ok:
            found.append(p_str)
    return found


def regressed_of(states: list[dict]) -> list[str]:
    """sha256 of cases that were caught once and are not FAIL now."""
    return [c["sha"] for c in states if c["caught"] and c["state"] != "caught"]


def commit_baseline(root: Path, cfg: dict, ledger: Path, states: list[dict], kinds: list[str]) -> None:
    """Mark newly caught cases in their case.json and cache today's gate hash for `kinds`."""
    for c in states:
        if c["state"] == "caught" and not c["caught"]:
            atomic_write(c["dir"] / "case.json", json.dumps({**c["data"], "caught": True}, indent=2))
    base = read_baseline(ledger)
    base["ts"] = now()
    base.pop("caught", None)
    for k in kinds:
        base.setdefault("gate_hash", {})[k] = gate_hash(root, cfg["kinds"][k])
    atomic_write(ledger / "baseline.json", json.dumps(base, indent=2))


def regression_cases(root: Path, cfg: dict, ledger: Path, kind: str, kind_cfg: dict, states: list[dict]) -> list[str]:
    """[] when the cached gate hash for the kind is current. Otherwise check the kind's cases: if clean, commit and return [];
    if not, return the <a12> of each regressed case (['false-block'] when only a false block was found)."""
    if read_baseline(ledger).get("gate_hash", {}).get(kind) == gate_hash(root, kind_cfg):
        return []
    regressed = regressed_of(states)
    if regressed:
        return [r[:12] for r in regressed]
    if false_blocks(root, cfg, ledger, kind):
        return ["false-block"]
    commit_baseline(root, cfg, ledger, states, [kind])
    return []


def round_state(ledger: Path, slug: str, cap: int) -> str | None:
    """'round-cap', 'parked' or None."""
    switches = [s for s in read_jsonl(ledger / "switches.jsonl") if s.get("slug") == slug]
    switch_ts = switches[-1].get("ts") if switches else None
    count = sum(1 for v in read_jsonl(ledger / "verdicts.jsonl")
                if v.get("slug") == slug and v.get("level") in ("rejected", "for-now")
                and (switch_ts is None or v.get("ts", "") > switch_ts))
    if count < cap:
        return None
    return "round-cap" if switch_ts is None else "parked"


def is_rejected(ledger: Path, sha: str) -> bool:
    """Sticky: the newest 'rejected' verdict on this sha256 stands until a later verdict cites a hook-sourced owner message."""
    verdicts = [v for v in read_jsonl(ledger / "verdicts.jsonl") if v.get("sha256") == sha]
    last = max((i for i, v in enumerate(verdicts) if v.get("level") == "rejected"), default=None)
    if last is None:
        return False
    hook_ids = {m.get("id") for m in read_jsonl(ledger / "owner_msgs.jsonl") if m.get("source") == "hook"}
    return not any(v.get("msg") in hook_ids for v in verdicts[last + 1:])


def deny(reason: str) -> int:
    sys.stderr.write(f"DENY {reason}\n")
    return 2


def cmd_gate(root: Path, cfg: dict, ledger: Path, args) -> int:
    """Any exception propagates to main, which answers DENY error (exit 2). ALLOW is the last thing printed."""
    artifact, kind, kind_cfg, input_path, slug = resolve(root, cfg, args.artifact)
    g_hash = gate_hash(root, kind_cfg)
    art_sha, inp_sha = file_sha(artifact), file_sha(input_path)

    states = case_states(root, cfg, ledger, only_kind=kind)
    if any(c["bad"] for c in states):
        raise ValueError("unreadable case.json: " + " ".join(c["sha"] for c in states if c["bad"]))
    reg = regression_cases(root, cfg, ledger, kind, kind_cfg, states)
    if reg:
        return deny(f"regression: {' '.join(reg)}")
    if is_rejected(ledger, art_sha):
        return deny(f"rejected: artifact {art_sha[:12]} was rejected")
    r_state = round_state(ledger, slug, kind_cfg["round_cap"])
    if r_state == "round-cap":
        return deny(f"round-cap: slug {slug} reached round cap; run ratchet switch")
    if r_state == "parked":
        return deny(f"parked: slug {slug} is parked after switch")

    slug_shows = [s for s in read_jsonl(ledger / "shows.jsonl") if s.get("slug") == slug]
    last_show = slug_shows[-1] if slug_shows else None
    diff_text = None
    if last_show and last_show.get("inputs_hash") != inp_sha:
        if not args.inputs_changed:
            return deny("inputs-changed: inputs changed without --inputs-changed")
        old_file = ledger / "inputs" / (last_show.get("inputs_hash") or "-")
        old_lines = old_file.read_text(errors="replace").splitlines(keepends=True) if old_file.is_file() else []
        new_lines = input_path.read_text(errors="replace").splitlines(keepends=True)
        diff_text = "".join(difflib.unified_diff(old_lines, new_lines, "previous", "current"))[:4000]

    key = f"{art_sha[:12]}.{g_hash[:12]}.{inp_sha[:12]}"
    rec = run_check(root, ledger, kind_cfg, artifact, input_path, key)
    if rec["result"] == "ERROR":
        return deny(f"error: {rec.get('detail', '')}")
    if rec["result"] == "FAIL":
        out_p = (ledger / (rec.get("out") or f"checks/{key}.out.json")).resolve()
        tail_str = f" {rec['detail']}" if rec.get("detail") else ""
        return deny(f"check-fail:{tail_str} {out_p}")

    blind = sorted(c["sha"][:12] for c in case_states(root, cfg, ledger, only_kind=kind) if c["state"] == "blind")
    show_rec = {"ts": now(), "sha256": art_sha, "path": str(artifact), "kind": kind, "slug": slug,
                "gate_hash": g_hash, "inputs_hash": inp_sha, "pictures": [file_sha(Path(p).resolve()) for p in args.pictures],
                "inputs_why": args.inputs_changed or None, "inputs_diff": diff_text}
    if not args.dry_run:
        append_jsonl(ledger / "shows.jsonl", show_rec)
        inp_dest = ledger / "inputs" / inp_sha
        if not inp_dest.is_file():
            inp_dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(input_path, inp_dest)
    print(f"ALLOW {slug} {art_sha[:12]}")
    for b in blind:
        print(f"BLIND {b}")
    return 0


def fail(reason: str) -> int:
    sys.stderr.write(f"error: {reason}\n")
    return 1


def cmd_verdict(root: Path, cfg: dict, ledger: Path, args) -> int:
    try:
        artifact, kind, kind_cfg, input_path, slug = resolve(root, cfg, args.artifact)
        art_sha = file_sha(artifact)
        if args.quote is not None:
            m_id, msg_source = f"m-{secrets.token_hex(4)}", "agent"
        else:
            m_id = args.msg
            msg = next((m for m in read_jsonl(ledger / "owner_msgs.jsonl") if m.get("id") == m_id), None)
            if msg is None:
                return fail(f"unknown owner message id: {m_id}")
            msg_source = msg.get("source")
    except Exception as exc:
        return fail(str(exc))

    if args.quote is not None:
        append_jsonl(ledger / "owner_msgs.jsonl", {"id": m_id, "ts": now(), "source": "agent",
                                                   "session": os.environ.get("RATCHET_SESSION"), "text": args.quote})
    level = args.level
    if level == "satisfied" and msg_source != "hook":
        level = "for-now"
        sys.stderr.write("NOTE satisfied needs a hook-captured owner message; recorded for-now\n")

    case_dir = ledger / "cases" / art_sha
    if level == "rejected" and not (case_dir / "case.json").exists():  # a frozen case is never changed
        case_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy2(artifact, case_dir / artifact.name)
        shutil.copy2(input_path, case_dir / input_path.name)
        atomic_write(case_dir / "case.json", json.dumps({
            "sha256": art_sha, "kind": kind, "slug": slug, "verdict": level,
            "artifact": artifact.name, "input": input_path.name, "caught": False}, indent=2))

    append_jsonl(ledger / "verdicts.jsonl", {
        "id": f"v-{secrets.token_hex(4)}", "ts": now(), "sha256": art_sha, "path": str(artifact), "kind": kind,
        "slug": slug, "level": level, "msg": m_id, "session": os.environ.get("RATCHET_SESSION"),
        "harness": os.environ.get("RATCHET_HARNESS")})
    print(f"RECORDED {level} {slug} {art_sha[:12]} msg={m_id}")
    return 0


def cmd_calibrate(root: Path, cfg: dict, ledger: Path, args) -> int:
    if args.kind and args.kind not in cfg["kinds"]:
        return fail("unknown kind")
    read_baseline(ledger)  # a corrupt baseline is an error here, not an absent one
    states = case_states(root, cfg, ledger, only_kind=args.kind)
    blocks = false_blocks(root, cfg, ledger, args.kind)
    for c in states:
        print(f"error {c['sha']}" if c["bad"] else f"{c['state']} {c['sha'][:12]}")
    for p in blocks:
        print(f"false-block {p}")
    if regressed_of(states) or blocks:
        print("CALIBRATE regression")
        return 1
    if any(c["bad"] for c in states):
        print("CALIBRATE error")
        return 1
    commit_baseline(root, cfg, ledger, states, [args.kind] if args.kind else list(cfg["kinds"]))
    print("CALIBRATE ok")
    return 0


def cmd_switch(root: Path, cfg: dict, ledger: Path, args) -> int:
    if any(s.get("slug") == args.slug for s in read_jsonl(ledger / "switches.jsonl")):
        return deny(f"switch-used: slug {args.slug} already has a switch")
    append_jsonl(ledger / "switches.jsonl", {"ts": now(), "slug": args.slug, "what": args.what})
    print(f"SWITCHED {args.slug}")
    return 0


def cmd_status(root: Path, cfg: dict, ledger: Path, args) -> int:
    """Never starts a check: reads cached results only."""
    print(f"ratchet: {root.name}")
    baseline = read_baseline(ledger)
    states = case_states(root, cfg, ledger, cached_only=True)
    if states:
        print(f"cases {len(states)} (blind {sum(1 for c in states if c['state'] == 'blind')})")

    verdicts = read_jsonl(ledger / "verdicts.jsonl")
    rej_ts = {v["sha256"]: v.get("ts", "") for v in verdicts if v.get("level") == "rejected" and "sha256" in v}
    for c in sorted(states, key=lambda c: rej_ts.get(c["sha"], ""), reverse=True)[:3]:
        print(f"error {c['sha']}" if c["bad"] else f"{c['sha'][:12]} rejected -> {c['state']}")

    newest = newest_by(ledger, "sha256").values()
    for level in ("rejected", "for-now"):
        n = sum(1 for v in newest if v.get("level") == level)
        if n:
            print(f"{level} {n}")

    slug_kind = {v["slug"]: v.get("kind") for v in verdicts if v.get("slug")}
    shows = read_jsonl(ledger / "shows.jsonl")
    slug_kind.update({s["slug"]: s["kind"] for s in shows if s.get("slug") and s.get("kind")})
    slugs = set(slug_kind) | {s["slug"] for s in shows if s.get("slug")} \
        | {s["slug"] for s in read_jsonl(ledger / "switches.jsonl") if s.get("slug")}
    by_state: dict[str, list[str]] = {"parked": [], "round-cap": []}
    for slug in sorted(slugs):
        k_cfg = cfg["kinds"].get(slug_kind.get(slug, ""))
        st = round_state(ledger, slug, k_cfg["round_cap"] if k_cfg else 3)
        if st:
            by_state[st].append(slug)
    for st, names in by_state.items():
        if names:
            print(f"{st} {len(names)}: {' '.join(names[:3])}")

    stale = any(gate_hash(root, k_cfg) != baseline.get("gate_hash", {}).get(k) for k, k_cfg in cfg["kinds"].items())
    print("baseline: stale (gate changed since last calibrate)" if stale else "baseline: current")
    return 0


class SilentUsageParser(argparse.ArgumentParser):
    def error(self, message):
        sys.stderr.write(f"error: {message}\n")
        sys.exit(1)


def main(argv=None) -> int:
    root = find_root(Path.cwd())
    if root is None:
        return 0

    parser = SilentUsageParser(prog="ratchet")
    sub = parser.add_subparsers(dest="subcommand", required=True)

    p = sub.add_parser("gate")
    p.add_argument("artifact")
    p.add_argument("--pictures", nargs="*", default=[])
    p.add_argument("--inputs-changed", dest="inputs_changed", metavar="WHY", default=None)
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_gate)

    p = sub.add_parser("verdict")
    p.add_argument("artifact")
    p.add_argument("level", choices=["satisfied", "for-now", "rejected", "no-comment"])
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--msg", default=None)
    g.add_argument("--quote", default=None)
    p.set_defaults(func=cmd_verdict)

    p = sub.add_parser("calibrate")
    p.add_argument("--kind", default=None)
    p.set_defaults(func=cmd_calibrate)

    p = sub.add_parser("switch")
    p.add_argument("slug")
    p.add_argument("--what", required=True)
    p.set_defaults(func=cmd_switch)

    sub.add_parser("status").set_defaults(func=cmd_status)

    args = parser.parse_args(argv)
    try:
        cfg, ledger = load(root)
        return args.func(root, cfg, ledger, args)
    except Exception as exc:
        return deny(f"error: {exc}") if args.subcommand == "gate" else fail(str(exc))


if __name__ == "__main__":
    sys.exit(main())
