#!/usr/bin/env python3
"""agent-spend-weekly: last 7 days of agent token spend vs commits landed on main.

Appends one JSON line per run to the log, prints a table.
    agent-spend-weekly
    agent-spend-weekly --repo NAME:PATH:GLOB [--repo ...] --log FILE --projects DIR
Commits count origin/main (fetched first) because local main goes stale between
pulls; a repo that cannot be read reports null, never a misleading zero.
"""
import argparse, json, os, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
WINDOW_DAYS = 7
DEFAULT_LOG = "~/.claude/logs/agent-spend-weekly.jsonl"
DEFAULT_REPOS = [
    "play-joymify:~/workspace/repos/play-joymify:*repos-play-joymify*",
    "joy-quest:~/workspace/joy-quest:*joy-quest*",
    "atlas-world-svc:~/workspace/repos/atlas-world-svc:*atlas-world-svc*",
]
POOLS = ("main", "subagents", "workflows")

def git(path, *args, timeout=120):
    return subprocess.run(["git", "-C", path, *args], capture_output=True, text=True, timeout=timeout)

def commits_on_main(path):
    if not os.path.isdir(path):
        return None
    try:
        git(path, "fetch", "-q", "--no-tags", "origin", "main")  # offline: use the last fetch
        ref = "origin/main" if git(path, "rev-parse", "-q", "--verify", "refs/remotes/origin/main").returncode == 0 else "main"
        res = git(path, "rev-list", "--count", f"--since={WINDOW_DAYS}.days", ref)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return int(res.stdout) if res.returncode == 0 else None

def spend(pattern, projects):
    cmd = [sys.executable, os.path.join(HERE, "agent-spend"), "--json", "--since-days", str(WINDOW_DAYS), "--projects", projects, pattern]
    return json.loads(subprocess.run(cmd, capture_output=True, text=True, check=True).stdout)[0]

def row(spec, projects):
    name, path, pattern = spec.split(":", 2)
    spent = spend(pattern, projects)
    commits = commits_on_main(os.path.expanduser(path))
    if commits is None:
        print(f"agent-spend-weekly: cannot read commits for {name} at {path}", file=sys.stderr)
    context = sum(spent[p]["context_tokens"] for p in POOLS)
    return {
        "repo": name,
        "commits": commits,
        "context_tokens": context,
        "output_tokens": sum(spent[p]["output_tokens"] for p in POOLS),
        "context_by_pool": {p: spent[p]["context_tokens"] for p in POOLS},
        "tokens_per_commit": context // commits if commits else None,
    }

def human(n):
    if n is None:
        return "-"
    return f"{n/1e9:.2f}B" if n >= 1e9 else f"{n/1e6:.1f}M" if n >= 1e6 else str(n)

def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--repo", action="append", help="NAME:PATH:GLOB")
    ap.add_argument("--log", default=DEFAULT_LOG)
    ap.add_argument("--projects", default=os.path.expanduser(os.environ.get("CLAUDE_PROJECTS_DIR", "~/.claude/projects")))
    a = ap.parse_args(argv)

    rows = [row(spec, a.projects) for spec in a.repo or DEFAULT_REPOS]
    log = os.path.expanduser(a.log)
    os.makedirs(os.path.dirname(log), exist_ok=True)
    with open(log, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "window_days": WINDOW_DAYS, "repos": rows}) + "\n")

    print(f"{'repo':20}{'commits':>8}{'context':>10}{'output':>10}{'ctx/commit':>12}")
    for r in rows:
        print(f"{r['repo'][:20]:20}{human(r['commits']):>8}{human(r['context_tokens']):>10}{human(r['output_tokens']):>10}{human(r['tokens_per_commit']):>12}")
    return 0

if __name__ == "__main__":
    sys.exit(main())
