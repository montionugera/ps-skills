#!/usr/bin/env python3
"""img-preview-link — Stage images into ~/.cache/img-preview and return Tailscale HTTPS preview URLs.

Also runs the local read-only HTTP server on 127.0.0.1:8789 when called with `--serve`.

Usage:
  img-preview-link <file1> [file2 ...]        # Stage image(s) and print clickable HTTPS URL(s)
  img-preview-link --markdown <file1> ...     # Print Markdown link(s): [🖼 basename](https://...)
  img-preview-link --hook-agy                 # AGY PostToolUse hook (reads stdin JSON)
  img-preview-link --serve                    # Run HTTP server on 127.0.0.1:8789 serving ~/.cache/img-preview
"""

from __future__ import annotations

import argparse
import hashlib
import http.server
import json
import os
import shutil
import socketserver
import subprocess
import sys
import urllib.parse
from pathlib import Path

CACHE_DIR = Path.home() / ".cache" / "img-preview"
PORT = int(os.environ.get("IMG_PREVIEW_PORT", "8789"))
TAILSCALE_HTTPS_PORT = int(os.environ.get("IMG_PREVIEW_TS_PORT", "8444"))
DEFAULT_TS_HOST = "pasits-macbook-pro.taild6b5fe.ts.net"
IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg", ".bmp", ".tiff", ".tif", ".heic", ".avif"}


def get_tailscale_host() -> str:
    env_host = os.environ.get("IMG_PREVIEW_TS_HOST")
    if env_host:
        return env_host.rstrip(".")
    try:
        out = subprocess.check_output(
            ["tailscale", "status", "--self", "--json"],
            stderr=subprocess.DEVNULL,
            timeout=1.5,
            text=True,
        )
        data = json.loads(out)
        dns = (data.get("Self") or {}).get("DNSName", "").rstrip(".")
        if dns:
            return dns
    except Exception:
        pass
    return DEFAULT_TS_HOST


def stage_image(path_str: str) -> tuple[Path, str] | None:
    p = Path(path_str).expanduser()
    if not p.is_file():
        return None
    ext = p.suffix.lower()
    if ext not in IMAGE_EXTS:
        return None
    rp = p.resolve()  # the path the gate checks is the path that gets copied (no swap in between)
    for d in rp.parents:  # a repo-level executable .img-preview-gate may refuse the file before anything is staged
        g = d / ".img-preview-gate"
        if g.is_file():
            if not os.access(g, os.X_OK):  # a gate that cannot run must not wave the file through
                print(f"{g} is not executable; refusing to stage {p}", file=sys.stderr)
                return None
            r = subprocess.run([str(g), str(rp)], capture_output=True, text=True)
            if r.returncode != 0:
                print(r.stderr.strip() or f"{g} refused {p}", file=sys.stderr)
                return None
            break
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    st = rp.stat()
    digest = hashlib.sha256(f"{rp}|{st.st_mtime_ns}|{st.st_size}".encode()).hexdigest()[:10]
    safe_stem = "".join(c if c.isalnum() or c in ("-", "_") else "_" for c in p.stem)[:48]
    staged_name = f"{safe_stem}-{digest}{ext}"
    staged_path = CACHE_DIR / staged_name
    if not staged_path.exists():
        tmp_path = CACHE_DIR / f".{staged_name}.tmp.{os.getpid()}"
        shutil.copy2(rp, tmp_path)
        tmp_path.replace(staged_path)
    host = get_tailscale_host()
    url = f"https://{host}:{TAILSCALE_HTTPS_PORT}/{urllib.parse.quote(staged_name)}"
    return p, url


class PreviewHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(CACHE_DIR), **kwargs)

    def log_message(self, format: str, *args) -> None:
        pass

    def end_headers(self) -> None:
        self.send_header("Cache-Control", "public, max-age=3600")
        self.send_header("Access-Control-Allow-Origin", "*")
        super().end_headers()

    def do_GET(self) -> None:
        if self.path in ("/", "/index.html"):
            self.send_Index()
            return
        super().do_GET()

    def send_Index(self) -> None:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        files = sorted(
            [f for f in CACHE_DIR.iterdir() if f.is_file() and not f.name.startswith(".")],
            key=lambda f: f.stat().st_mtime,
            reverse=True,
        )[:60]
        items = []
        for f in files:
            q = urllib.parse.quote(f.name)
            items.append(
                f'<div class="card"><a href="/{q}" target="_blank">'
                f'<img src="/{q}" loading="lazy" alt="{f.name}"/>'
                f'<div class="name">{f.name}</div></a></div>'
            )
        body = f"""<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Image Previews</title>
<style>
body {{ background:#0d1117; color:#e6edf3; font-family:system-ui,sans-serif; margin:20px; }}
h1 {{ font-size:18px; margin-bottom:16px; }}
.grid {{ display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px; }}
.card {{ background:#161b22; border:1px solid #30363d; border-radius:8px; overflow:hidden; }}
.card a {{ color:#58a6ff; text-decoration:none; display:block; }}
.card img {{ width:100%; height:160px; object-fit:contain; background:#010409; display:block; }}
.name {{ padding:8px; font-size:12px; word-break:break-all; }}
</style></head><body>
<h1>Recent Image Previews ({len(files)})</h1>
<div class="grid">{''.join(items) or '<p>No images staged yet.</p>'}</div>
</body></html>""".encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def serve() -> int:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("127.0.0.1", PORT), PreviewHandler) as httpd:
        httpd.serve_forever()
    return 0


def handle_hook() -> int:
    try:
        raw = sys.stdin.read()
        if not raw.strip():
            print("{}")
            return 0
        payload = json.loads(raw)
        # Support both AGY (toolCall.args.Path) and Claude/Codex (tool_input.file_path / path)
        path_str = (
            ((payload.get("toolCall") or {}).get("args") or {}).get("Path")
            or ((payload.get("toolCall") or {}).get("args") or {}).get("file_path")
            or (payload.get("tool_input") or {}).get("file_path")
            or (payload.get("tool_input") or {}).get("path")
            or ""
        )
        if path_str:
            stage_image(path_str)
    except Exception:
        pass
    print("{}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Stage images and print Tailscale preview links.")
    parser.add_argument("--serve", action="store_true", help="Run local HTTP preview server")
    parser.add_argument("--hook", action="store_true", help="Run as PostToolUse hook (stdin JSON -> {})")
    parser.add_argument("--markdown", "-m", action="store_true", help="Format output as Markdown links")
    parser.add_argument("files", nargs="*", help="Image file paths to stage")
    args = parser.parse_args()

    if args.serve:
        return serve()
    if args.hook:
        return handle_hook()

    if not args.files:
        host = get_tailscale_host()
        print(f"https://{host}:{TAILSCALE_HTTPS_PORT}/")
        return 0

    rc = 0
    for f in args.files:
        res = stage_image(f)
        if not res:
            print(f"img-preview-link: skipped (not an existing image file): {f}", file=sys.stderr)
            rc = 1
            continue
        orig, url = res
        if args.markdown:
            print(f"[🖼 {orig.name}]({url})")
        else:
            print(url)
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
