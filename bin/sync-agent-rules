#!/usr/bin/env python3
"""sync-agent-rules: generate agy's rule file from the one hand-maintained source.

~/.gemini/GEMINI.md used to be a hand copy of ~/.claude/CLAUDE.md and went stale
(the Target Fidelity Tiers block never reached agy). This makes it a build output:

    generated = header + source (with `@file` import lines resolved inline)
                       + optional <target-dir>/GEMINI.local.md (agy-only rules)

    sync-agent-rules --check    exit 1 + bounded diff when the target is out of date
    sync-agent-rules --write    back the target up to <target>.bak-<timestamp>, then write

Exit codes: 0 in sync / written, 1 out of date (--check), 2 usage or unusable paths.
"""
import argparse
import difflib
import os
import re
import shutil
import sys
import tempfile
from datetime import datetime
from pathlib import Path

DEFAULT_SOURCE = "~/.claude/CLAUDE.md"
DEFAULT_TARGET = "~/.gemini/GEMINI.md"
LOCAL_NAME = "GEMINI.local.md"
MAX_IMPORT_DEPTH = 5

_IMPORT_RE = re.compile(r"^@(\S+)$")
_FENCE_RE = re.compile(r"^\s*(```|~~~)")


class SyncError(Exception):
    pass


def _display(path: Path) -> str:
    """Path with $HOME collapsed to ~, so the header is stable across machines."""
    try:
        return "~/" + str(path.relative_to(Path.home()))
    except ValueError:
        return str(path)


def resolve_imports(path: Path, seen: tuple[Path, ...] = ()) -> str:
    """Text of `path` with whole-line `@file` imports replaced by that file's text.

    Imports resolve relative to the importing file. Lines inside code fences, imports
    of files that do not exist, cycles, and anything past MAX_IMPORT_DEPTH are kept
    verbatim (with a warning) rather than dropped.
    """
    real = path.resolve()
    out, in_fence = [], False
    for line in path.read_text(encoding="utf-8").splitlines():
        if _FENCE_RE.match(line):
            in_fence = not in_fence
        match = None if in_fence else _IMPORT_RE.match(line)
        if not match:
            out.append(line)
            continue
        imported = (path.parent / Path(match.group(1)).expanduser())
        reason = None
        if not imported.is_file():
            reason = "file not found"
        elif imported.resolve() in (*seen, real):
            reason = "import cycle"
        elif len(seen) + 1 >= MAX_IMPORT_DEPTH:
            reason = f"deeper than {MAX_IMPORT_DEPTH} imports"
        if reason:
            print(f"WARNING: {line} in {path} left as is ({reason})", file=sys.stderr)
            out.append(line)
            continue
        out.append(f"<!-- BEGIN {line} -->")
        out.append(resolve_imports(imported, (*seen, real)).rstrip("\n"))
        out.append(f"<!-- END {line} -->")
    return "\n".join(out) + "\n"


def generate(source: Path, local: Path) -> str:
    if not source.is_file():
        raise SyncError(f"source not found: {source}")
    parts = [
        f"<!-- GENERATED from {_display(source)} by sync-agent-rules — do not edit by hand. "
        f"Agy-only rules belong in {_display(local)}. -->\n",
        resolve_imports(source),
    ]
    if local.is_file():
        parts.append(f"<!-- BEGIN {local.name} (hand-maintained, agy-only) -->\n")
        parts.append(local.read_text(encoding="utf-8").rstrip("\n") + "\n")
    return "\n".join(parts)


def check(generated: str, target: Path, max_diff_lines: int) -> int:
    current = target.read_text(encoding="utf-8") if target.is_file() else ""
    if current == generated:
        print(f"in sync: {target}")
        return 0
    diff = list(difflib.unified_diff(
        current.splitlines(), generated.splitlines(),
        fromfile=f"{target} (current)", tofile=f"{target} (generated)", lineterm="", n=1,
    ))
    added = sum(1 for d in diff[2:] if d.startswith("+"))
    removed = sum(1 for d in diff[2:] if d.startswith("-"))
    state = "OUT OF DATE" if target.is_file() else "MISSING"
    print(f"{state}: {target}  (+{added} / -{removed} lines; fix with --write)")
    print("\n".join(diff[:max_diff_lines]))
    if len(diff) > max_diff_lines:
        print(f"... ({len(diff) - max_diff_lines} more diff lines)")
    return 1


def write(generated: str, source: Path, target: Path) -> int:
    if target.is_symlink() or (target.exists() and target.resolve() == source.resolve()):
        raise SyncError(
            f"refusing to write: {target} is a symlink or the source itself — "
            f"writing through it could overwrite {source}")
    if target.is_file() and target.read_text(encoding="utf-8") == generated:
        print(f"already in sync: {target}")
        return 0
    if target.exists():
        backup = target.with_name(
            f"{target.name}.bak-{datetime.now().strftime('%Y%m%d-%H%M%S')}")
        shutil.copy2(target, backup)
        print(f"backed up: {backup}")
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=target.parent, prefix=f".{target.name}.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(generated)
        os.replace(tmp, target)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise
    print(f"wrote: {target}")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(
        prog="sync-agent-rules",
        description="Generate agy's GEMINI.md from CLAUDE.md (one source of rules).",
    )
    mode = p.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true",
                      help="exit 1 and print a bounded diff when the target is out of date")
    mode.add_argument("--write", action="store_true",
                      help="back up the target, then write the generated file")
    p.add_argument("--source", default=DEFAULT_SOURCE, help=f"default {DEFAULT_SOURCE}")
    p.add_argument("--target", default=DEFAULT_TARGET, help=f"default {DEFAULT_TARGET}")
    p.add_argument("--local", default=None,
                   help=f"agy-only rules appended verbatim (default <target dir>/{LOCAL_NAME})")
    p.add_argument("--max-diff-lines", type=int, default=40,
                   help="cap on diff lines printed by --check (default 40)")
    args = p.parse_args()

    source = Path(args.source).expanduser()
    target = Path(args.target).expanduser()
    local = Path(args.local).expanduser() if args.local else target.parent / LOCAL_NAME
    try:
        generated = generate(source, local)
        if args.check:
            return check(generated, target, args.max_diff_lines)
        return write(generated, source, target)
    except (SyncError, OSError, UnicodeDecodeError) as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
