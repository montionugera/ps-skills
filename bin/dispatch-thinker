#!/usr/bin/env bash
# dispatch-thinker: Front-end for dispatch-worker with --capability deep-design-v1
# Strictly restricts thinking / architecture tasks to Claude Fable or GPT-5.6-Sol.
# Fails closed with exit code 12 if thinker is unavailable.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKER="$SCRIPT_DIR/dispatch-worker"

exec "$WORKER" --capability deep-design-v1 "$@"
