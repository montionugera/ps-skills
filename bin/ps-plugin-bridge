#!/usr/bin/env python3
"""ps-plugin-bridge — Bridge installed Claude plugins to Google Antigravity.

Reads Claude's installed plugins from ~/.claude/plugins/installed_plugins.json
and bridges each plugin to Antigravity at ~/.gemini/config/plugins/<name>.

Key behaviors:
1. Identifies plugin installPath from ~/.claude/plugins/installed_plugins.json.
2. Creates symlink ~/.gemini/config/plugins/<name> -> <installPath>.
3. Ensures plugin.json exists at root: if .claude-plugin/plugin.json exists and
   plugin.json is missing, creates relative symlink plugin.json -> .claude-plugin/plugin.json.
4. Verifies skills/ within the plugin are accessible and recognized by Antigravity.
5. Validates each plugin using `agy plugin validate`.

Usage:
  ps-plugin-bridge --list       # Show installed plugins and Antigravity bridge status
  ps-plugin-bridge --sync       # Bridge plugins to ~/.gemini/config/plugins/
  ps-plugin-bridge --dry-run    # Preview bridge actions without making changes
  ps-plugin-bridge --sync -n    # Dry-run sync preview
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

DEFAULT_CLAUDE_INSTALLED = os.path.expanduser("~/.claude/plugins/installed_plugins.json")
DEFAULT_GEMINI_PLUGINS = os.path.expanduser("~/.gemini/config/plugins")


class PluginBridge:
    def __init__(
        self,
        installed_json: str = DEFAULT_CLAUDE_INSTALLED,
        gemini_plugins_dir: str = DEFAULT_GEMINI_PLUGINS,
        dry_run: bool = False,
    ):
        self.installed_json = Path(installed_json)
        self.gemini_plugins_dir = Path(gemini_plugins_dir)
        self.dry_run = dry_run
        self.agy_bin = shutil.which("agy")

    def load_installed_plugins(self) -> Dict[str, Any]:
        """Loads and parses installed_plugins.json."""
        if not self.installed_json.is_file():
            raise FileNotFoundError(f"Claude installed plugins not found at: {self.installed_json}")
        with open(self.installed_json, "r", encoding="utf-8") as f:
            return json.load(f)

    def get_plugin_entries(self) -> List[Dict[str, Any]]:
        """Extracts normalized plugin details from installed_plugins.json."""
        data = self.load_installed_plugins()
        plugins_data = data.get("plugins", {})
        entries = []

        for key, val in plugins_data.items():
            name = key.split("@")[0]
            item = val[0] if isinstance(val, list) and val else (val if isinstance(val, dict) else {})
            install_path = item.get("installPath")
            version = item.get("version", "unknown")

            entries.append({
                "key": key,
                "name": name,
                "version": version,
                "install_path": install_path,
                "target_path": self.gemini_plugins_dir / name,
            })

        return entries

    def get_plugin_skills_count(self, plugin_dir: Path) -> int:
        """Counts recognizable skills in plugin directory."""
        skills_dir = plugin_dir / "skills"
        if not skills_dir.is_dir():
            return 0
        count = 0
        for item in skills_dir.iterdir():
            if item.is_dir() and (item / "SKILL.md").is_file():
                count += 1
            elif item.is_dir():
                for sub in item.iterdir():
                    if sub.is_dir() and (sub / "SKILL.md").is_file():
                        count += 1
        return count

    def validate_with_agy(self, plugin_path: Path) -> Tuple[bool, str]:
        """Runs `agy plugin validate` if agy is installed."""
        if not self.agy_bin:
            return True, "agy not found in PATH (skipped validation)"
        try:
            res = subprocess.run(
                [self.agy_bin, "plugin", "validate", str(plugin_path)],
                capture_output=True,
                text=True,
                timeout=10,
            )
            if res.returncode == 0:
                first_line = res.stdout.strip().split("\n")[0] if res.stdout.strip() else "[ok]"
                return True, first_line
            else:
                err = (res.stderr or res.stdout).strip().split("\n")[0]
                return False, err
        except Exception as e:
            return False, str(e)

    def list_plugins(self) -> None:
        """Lists plugins and their Antigravity bridge status."""
        entries = self.get_plugin_entries()
        print(f"Claude Plugins ({len(entries)} installed):")
        print(f"Config source: {self.installed_json}")
        print(f"Gemini target: {self.gemini_plugins_dir}\n")

        for entry in entries:
            name = entry["name"]
            version = entry["version"]
            ipath = entry["install_path"]
            target = entry["target_path"]

            print(f"• {name} (v{version})")
            print(f"  Source: {ipath}")

            if not ipath or not Path(ipath).is_dir():
                print("  Status: ❌ Source path missing on disk\n")
                continue

            if not target.exists() and not target.is_symlink():
                print("  Status: ⚪ Not bridged to Antigravity\n")
            elif target.is_symlink():
                dest = os.readlink(target)
                is_correct = os.path.abspath(dest) == os.path.abspath(ipath)
                target_pj = target / "plugin.json"
                skills_count = self.get_plugin_skills_count(target)
                has_pj = target_pj.is_file() or target_pj.is_symlink()

                status_icon = "✔" if (is_correct and has_pj) else "⚠"
                print(f"  Status: {status_icon} Symlinked -> {dest}")
                print(f"          plugin.json: {'✔' if has_pj else '❌ missing'}, skills: {skills_count}")
                if has_pj and self.agy_bin:
                    valid, msg = self.validate_with_agy(target)
                    print(f"          Antigravity: {'✔' if valid else '❌'} {msg}")
                print()
            else:
                target_pj = target / "plugin.json"
                skills_count = self.get_plugin_skills_count(target)
                has_pj = target_pj.is_file() or target_pj.is_symlink()
                print(f"  Status: 📁 Directory in ~/.gemini/config/plugins/{name}")
                print(f"          plugin.json: {'✔' if has_pj else '❌ missing'}, skills: {skills_count}")
                print()

    def sync_plugins(self) -> int:
        """Bridges Claude plugins to Antigravity."""
        entries = self.get_plugin_entries()
        action_count = 0
        success_count = 0

        prefix = "[DRY RUN] " if self.dry_run else ""
        print(f"{prefix}Syncing plugins to {self.gemini_plugins_dir}...\n")

        if not self.dry_run:
            self.gemini_plugins_dir.mkdir(parents=True, exist_ok=True)

        for entry in entries:
            name = entry["name"]
            ipath_str = entry["install_path"]
            target = entry["target_path"]

            if not ipath_str:
                print(f"⚠️  [{name}] No installPath defined. Skipping.")
                continue

            ipath = Path(ipath_str)
            if not ipath.is_dir():
                print(f"⚠️  [{name}] Install path does not exist: {ipath}. Skipping.")
                continue

            print(f"==> [{name}] (v{entry['version']})")

            # 1. Determine if target will be symlink or existing directory
            will_be_symlink = False
            if target.is_symlink():
                current_dest = os.readlink(target)
                if os.path.abspath(current_dest) != os.path.abspath(ipath):
                    action_count += 1
                    print(f"    Updating plugin symlink: {target} -> {ipath}")
                    if not self.dry_run:
                        target.unlink()
                        target.symlink_to(ipath)
                else:
                    print(f"    Plugin symlink up to date: {target} -> {ipath}")
                will_be_symlink = True
            elif target.is_dir():
                print(f"    Plugin target is an existing directory: {target}")
                will_be_symlink = False
            else:
                # Target does not exist (or broken symlink)
                if target.is_symlink():
                    if not self.dry_run:
                        target.unlink()
                action_count += 1
                print(f"    Creating plugin symlink: {target} -> {ipath}")
                if not self.dry_run:
                    target.symlink_to(ipath)
                will_be_symlink = True

            # 2. Ensure plugin.json exists at root
            # In install_path:
            ipath_pj = ipath / "plugin.json"
            ipath_claude_pj = ipath / ".claude-plugin" / "plugin.json"

            if not ipath_pj.exists() and not ipath_pj.is_symlink():
                if ipath_claude_pj.is_file():
                    action_count += 1
                    print(f"    Creating manifest symlink: {ipath_pj} -> .claude-plugin/plugin.json")
                    if not self.dry_run:
                        ipath_pj.symlink_to(".claude-plugin/plugin.json")
                else:
                    print(f"    ⚠️  No plugin.json found in {ipath} or .claude-plugin/")
            else:
                print(f"    plugin.json verified in installPath")

            # If target is a real directory (not symlinked to ipath), ensure target has plugin.json
            if not will_be_symlink:
                target_pj = target / "plugin.json"
                if not target_pj.exists() and not target_pj.is_symlink():
                    source_pj = ipath_pj if ipath_pj.exists() else ipath_claude_pj
                    if source_pj.exists():
                        action_count += 1
                        print(f"    Symlinking plugin.json into directory: {target_pj} -> {source_pj}")
                        if not self.dry_run:
                            target_pj.symlink_to(source_pj)

            # 3. Ensure skills/ within plugin are accessible
            if will_be_symlink:
                if (ipath / "skills").is_dir():
                    count = self.get_plugin_skills_count(ipath)
                    print(f"    skills/ verified: {count} skill(s) accessible")
                else:
                    print(f"    ℹ️  No skills/ directory in {ipath}")
            else:
                target_skills = target / "skills"
                if not target_skills.exists() and not target_skills.is_symlink():
                    if (ipath / "skills").is_dir():
                        action_count += 1
                        print(f"    Symlinking skills into directory: {target_skills} -> {ipath / 'skills'}")
                        if not self.dry_run:
                            target_skills.symlink_to(ipath / "skills")
                if target_skills.exists():
                    count = self.get_plugin_skills_count(target)
                    print(f"    skills/ verified: {count} skill(s) accessible")

            # 4. Antigravity validation
            if not self.dry_run and target.exists():
                valid, msg = self.validate_with_agy(target)
                if valid:
                    print(f"    Antigravity validation: ✔ {msg}")
                    success_count += 1
                else:
                    print(f"    Antigravity validation: ⚠️ {msg}")
            elif self.dry_run:
                print("    Antigravity validation: ℹ️  (skipped in dry-run)")
                success_count += 1
            else:
                success_count += 1

            print()

        mode_str = "Simulated" if self.dry_run else "Completed"
        print(f"{mode_str} bridge for {len(entries)} plugin(s) ({action_count} actions taken).")
        return 0


def main():
    parser = argparse.ArgumentParser(
        description="ps-plugin-bridge: Bridge installed Claude plugins to Google Antigravity.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  ps-plugin-bridge --list       # View installed plugins and bridge status
  ps-plugin-bridge --sync       # Bridge plugins right now
  ps-plugin-bridge --dry-run    # Preview bridge actions without making changes
""",
    )
    parser.add_argument(
        "--list", "-l", action="store_true", help="List installed plugins and Antigravity bridge status"
    )
    parser.add_argument(
        "--sync", "-s", action="store_true", help="Synchronize/bridge plugins to ~/.gemini/config/plugins/"
    )
    parser.add_argument(
        "--dry-run", "-n", action="store_true", help="Simulate actions without writing to disk"
    )
    parser.add_argument(
        "--installed-json",
        default=DEFAULT_CLAUDE_INSTALLED,
        help=f"Path to installed_plugins.json (default: {DEFAULT_CLAUDE_INSTALLED})",
    )
    parser.add_argument(
        "--gemini-plugins-dir",
        default=DEFAULT_GEMINI_PLUGINS,
        help=f"Path to Gemini plugins directory (default: {DEFAULT_GEMINI_PLUGINS})",
    )

    args = parser.parse_args()

    bridge = PluginBridge(
        installed_json=args.installed_json,
        gemini_plugins_dir=args.gemini_plugins_dir,
        dry_run=args.dry_run,
    )

    if args.list:
        bridge.list_plugins()
        return

    if args.sync or args.dry_run:
        sys.exit(bridge.sync_plugins())

    # Default to help if no flag provided
    parser.print_help()


if __name__ == "__main__":
    main()
