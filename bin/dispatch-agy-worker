#!/usr/bin/env python3
"""
dispatch-worker / dispatch-agy-worker
Dispatch an implementation task to Antigravity CLI (agy), Cursor CLI or `claude -p`
after verifying quota thresholds (5h > 30%, weekly > 10%).

Agents listed in DISABLED_AGENTS are never routed to, in any mode: naming one with --agent is
refused, and a --priority chain entry naming one is dropped with a one-line notice.

Thinking mode (--think / --capability deep-design-v1, the `dispatch-thinker` shim) routes to
Frontier thinkers: Claude Opus 5.5 (`claude -p`) or Gemini 4 Argon (`agy`). deep-design-v1 fails closed
with exit 12 when unavailable.

Exit Codes:
  0: Task executed successfully by external agent
  1: Task execution failed (or error in execution)
  10: Insufficient quota (signals orchestrator to fall back to internal Claude subagent)
  2: Invalid arguments / missing required task prompt / a disabled agent was named
  12: deep-design-v1 thinker unavailable (Claude Opus 5.5 / Gemini 4 Argon) or forbidden model
  13: Worker exited 0 but the verify command failed (twice); nothing was merged

Agy runs stream (`--output-format stream-json`): the final `response` is the job's output, the conversation id is
saved in the job state as soon as agy reports it, and the job log gets a throttled one-line heartbeat.
  DISPATCH_AGY_IDLE_SECONDS  kill an agy run that emits no event for this long (default 1200; 0 disables). When
                             the limit expires and the folder's files changed since the last check, the timer
                             resets instead; a silent step over the limit that changes no files is killed.
                             --timeout stays the hard wall-clock cap. The resume gets min(max(900, timeout/2),
                             timeout) seconds, so a job waits at most 2x --timeout in total.
  DISPATCH_AGY_RESUME        0 disables the single automatic resume (`agy --conversation <id>`) after an idle or
                             wall-clock kill. A resumed job reports RESUMED_UNVERIFIED (exit 0) unless its verify
                             command passed, in which case SUCCESS with resumed: true.
`files_changed` counts only paths new or changed since the job started; files_changed_shared marks a detached job
whose folder was also used by another job, where the count cannot be attributed.
"""

import argparse
import collections
import contextlib
import concurrent.futures
from contextlib import nullcontext
import datetime
import hashlib
import json
import os
import pty
import select
import shutil
import signal
import stat
import statistics
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

DEFAULT_CONFIG_PATH = os.path.expanduser("~/.config/dispatch/config.env")
DEFAULT_AGY_STATE = os.path.expanduser("~/.local/state/herdr/plugins/herdr-agent-quota/agy-statusline.observation.json")
DEFAULT_CODEX_STATE = os.path.expanduser("~/.local/state/herdr/plugins/herdr-agent-quota/codex-app-server.json")
DEFAULT_JOB_DIR = os.path.expanduser("~/.local/state/dispatch/jobs")
DEFAULT_EVENTS_FILE = os.path.expanduser("~/.local/state/dispatch/events.jsonl")  # override: DISPATCH_EVENTS_FILE
DEFAULT_LOG_DIR = "/tmp/dispatch-jobs"

DEFAULT_MIN_5H = float(os.environ.get("EXTERNAL_WORKER_MIN_5H_QUOTA", "30.0"))
DEFAULT_MIN_WEEKLY = float(os.environ.get("EXTERNAL_WORKER_MIN_WEEKLY_QUOTA", "10.0"))
DEFAULT_THINK_MIN_5H = float(os.environ.get("EXTERNAL_WORKER_THINK_MIN_5H_QUOTA", "80.0"))
DEFAULT_THINK_MIN_WEEKLY = float(os.environ.get("EXTERNAL_WORKER_THINK_MIN_WEEKLY_QUOTA", "20.0"))
# A quota observation older than this may hide quota spent since; it is not trusted for routing.
STALE_OBSERVATION_MINUTES = 60
DEFAULT_CODEX_MODEL = os.environ.get("CODEX_WORKER_MODEL", "gpt-5.6-terra")
DEFAULT_CODEX_THINK_MODEL = os.environ.get("CODEX_THINK_MODEL", "gpt-5.6-sol")
DEFAULT_AGY_WORKER_MODEL = os.environ.get("AGY_WORKER_MODEL", "gemini-3.8-flash-high")
DEFAULT_AGY_THINK_MODEL = os.environ.get("AGY_THINK_MODEL", "gemini-4-argon")
AGY_THINK_MODEL_NAMES = ("gemini-4-argon", "argon", "gemini-4-argon-thinking")

# Agents the dispatcher refuses to route to, in every mode (auto, priority chain, thinker, batch,
# runtime fallback). The single switch: remove a name here to route to that agent again.
DISABLED_AGENTS = frozenset({"codex"})
DEFAULT_CLAUDE_THINK_MODEL = os.environ.get("CLAUDE_THINK_MODEL", "claude-opus-5-5")
DEFAULT_THINK_EFFORT = os.environ.get("THINK_EFFORT") or os.environ.get("DISPATCH_THINK_EFFORT") or "medium"
DEFAULT_TIMEOUT = int(os.environ.get("AI_AGENT_AUTO_DISPATCH_TIMEOUT") or os.environ.get("DISPATCH_TIMEOUT") or "900")

DEFAULT_VERIFY_TIMEOUT = int(os.environ.get("DISPATCH_VERIFY_TIMEOUT") or "600")
DEFAULT_VERIFY_SCRIPT = "scripts/precheck.sh"
VERIFY_FAILED_EXIT_CODE = 13
# Worker exited 0, changed no files, and nothing verified the result: reported under its own name, still exit 0.
NO_CHANGES_UNVERIFIED_STATUS = "NO_CHANGES_UNVERIFIED"
# `--wait` stopped at its own limit while the job is still running (EX_TEMPFAIL: not a failure, wait again).
WAIT_STILL_RUNNING_EXIT_CODE = 75
# A job saved without a runner pid for longer than this never started: --wait reports it dead instead of hanging.
WAIT_ORPHAN_GRACE_SECONDS = 60
VERIFY_TAIL_LINES = 40
STALL_SECONDS = 300  # --status flags a RUNNING job STALLED? after this long without log output
# Resumed (after an idle/wall-clock kill) and exited 0 without a passing verify: finished, but not proven.
RESUMED_UNVERIFIED_STATUS = "RESUMED_UNVERIFIED"
DEFAULT_AGY_IDLE_SECONDS = 1200  # override: DISPATCH_AGY_IDLE_SECONDS (0 disables)
STREAM_NOTE_LINES = 5  # agy non-result events kept as evidence for a run that never reports a result
STREAM_NOTE_CHARS = 300
HEARTBEAT_SECONDS = 30  # at most one agy progress line in the job log per this many seconds
RESUME_MIN_BUDGET_SECONDS = 900

PROTECTED_CONFIG_PATTERNS = [
    ".release.json",
    ".git",
    "working-feature.json",
    "claims.json",
]


def new_run_id():
    return f"dw-{int(time.time())}-{os.urandom(3).hex()}"


def task_digest(task_text):
    """Short task fingerprint for the event log: a hash only, never any prompt text."""
    return {"task_sha": hashlib.sha256((task_text or "").encode("utf-8")).hexdigest()[:12]}


def emit_event(event, **fields):
    """Appends one JSON line to the dispatch event log with a single write. Never raises."""
    try:
        record = {"ts": time.time(), "event": event, "pid": os.getpid(), **fields}
        line = (json.dumps(record, default=str) + "\n").encode("utf-8")
        path = os.environ.get("DISPATCH_EVENTS_FILE") or DEFAULT_EVENTS_FILE
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            os.write(fd, line)
        finally:
            os.close(fd)
    except Exception:
        pass


def load_dispatch_config(config_path=None):
    """Loads key-value pairs from ~/.config/dispatch/config.env if present."""
    target = config_path or os.environ.get("DISPATCH_CONFIG_FILE", DEFAULT_CONFIG_PATH)
    if not os.path.isfile(target):
        return {}
    config = {}
    try:
        with open(target, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    config[k.strip()] = v.strip().strip("'\"")
    except Exception:
        pass
    return config


def detect_default_agent(prog_name):
    base = os.path.basename(prog_name)
    if "cursor" in base:
        return "cursor"
    if "codex" in base:
        return "codex"
    if "agy" in base:
        return "agy"
    return "auto"


def get_state_file(agent):
    if agent == "codex":
        return os.environ.get("CODEX_QUOTA_STATE_FILE", DEFAULT_CODEX_STATE)
    return os.environ.get("AGY_QUOTA_STATE_FILE", DEFAULT_AGY_STATE)


def _parse_resets_at(val):
    """Parses resets_at value which could be unix timestamp (int/float) or ISO 8601 string."""
    if val is None:
        return None
    if isinstance(val, (int, float)):
        return float(val)
    if isinstance(val, str):
        try:
            return float(val)
        except ValueError:
            pass
        try:
            # Parse ISO 8601 format like "2026-09-17T20:23:50Z"
            dt = datetime.datetime.fromisoformat(val.replace("Z", "+00:00"))
            return dt.timestamp()
        except Exception:
            return None
    return None


AGY_REFRESH_TIMEOUT_SECONDS = 20
AGY_REFRESH_HINT = "to refresh by hand, run `agy` in a terminal for a few seconds, quit it, and retry"


def _is_live_agy_observation(path):
    """True only for the real herdr observation file, so test state files never spawn agy."""
    return os.path.realpath(path) == os.path.realpath(DEFAULT_AGY_STATE)


def refresh_agy_observation(target_file, timeout=AGY_REFRESH_TIMEOUT_SECONDS):
    """Rewrites the agy quota observation without spending quota. Returns (refreshed, detail).

    Only agy's interactive TUI runs its statusLine hook (herdr-agent-quota agy-statusline),
    which is what writes the observation; `agy -p` never does, and agy has no usage command.
    So start an idle agy on a pseudo-terminal in $HOME, send no prompt, wait for the file's
    mtime to advance, then stop it.
    """
    agy_bin = shutil.which("agy") or os.path.expanduser("~/.local/bin/agy")
    if not os.path.exists(agy_bin):
        return False, "agy executable not found"
    try:
        before = os.path.getmtime(target_file)
        master, slave = pty.openpty()
    except OSError as e:
        return False, f"could not prepare the refresh: {e}"
    try:
        proc = subprocess.Popen([agy_bin], stdin=slave, stdout=slave, stderr=slave, cwd=os.path.expanduser("~"),
                                env=dict(os.environ, TERM=os.environ.get("TERM") or "xterm-256color"),
                                start_new_session=True)
    except OSError as e:
        os.close(master)
        os.close(slave)
        return False, f"could not start agy: {e}"
    os.close(slave)
    refreshed = False
    deadline = time.monotonic() + timeout
    try:
        while time.monotonic() < deadline and proc.poll() is None:
            ready, _, _ = select.select([master], [], [], 0.5)
            if ready:
                try:
                    os.read(master, 65536)  # keep draining so the TUI never blocks on a full pty
                except OSError:
                    break
            if os.path.getmtime(target_file) > before:
                refreshed = True
                break
    except OSError:
        pass
    finally:
        # Close the master before waiting: on macOS an exiting process blocks until its tty is released.
        os.close(master)
        for sig in (signal.SIGTERM, signal.SIGKILL):
            if proc.poll() is not None:
                break
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.killpg(proc.pid, sig)
            with contextlib.suppress(subprocess.TimeoutExpired):
                proc.wait(timeout=2)
    emit_event("quota_refresh", agent="agy", ok=refreshed)
    if refreshed:
        return True, "refreshed"
    return False, f"no statusLine write from an idle agy within {timeout}s"


def check_quota(agent="agy", state_file=None, min_5h=DEFAULT_MIN_5H, min_weekly=DEFAULT_MIN_WEEKLY, current_time=None):
    # Support positional state_file path for backwards compatibility
    if isinstance(agent, str) and ("/" in agent or "\\" in agent or agent.endswith(".json")) and state_file is None:
        state_file = agent
        agent = "agy"

    if agent == "claude":
        # Claude has no herdr quota telemetry: "available" means the binary is on PATH.
        if os.environ.get("DISPATCH_THINKER_SKIP_CLAUDE") == "1":
            return False, 0.0, 0.0, "[CLAUDE] skipped (DISPATCH_THINKER_SKIP_CLAUDE=1)"
        if not shutil.which("claude"):
            return False, 0.0, 0.0, "[CLAUDE] claude executable not found in PATH"
        return True, 100.0, 100.0, "[CLAUDE] available (no quota telemetry)"

    if agent == "cursor":
        cmd_path = shutil.which("cursor-agent") or os.path.expanduser("~/.local/bin/cursor-agent")
        if not os.path.exists(str(cmd_path)) and not shutil.which("cursor-agent"):
            return False, 0.0, 0.0, "cursor-agent executable not found in PATH"
        try:
            res = subprocess.run([cmd_path, "status"], capture_output=True, text=True, timeout=5)
            output = res.stdout.strip()
            if "Not logged in" in output or res.returncode != 0:
                return False, 0.0, 0.0, "Cursor CLI not logged in (run 'cursor-agent login')"
            first_line = output.splitlines()[0] if output else "Authenticated"
            return True, 100.0, 100.0, f"[CURSOR] Ready ({first_line})"
        except Exception as err:
            return False, 0.0, 0.0, f"Failed checking cursor-agent status: {err}"

    target_file = state_file or get_state_file(agent)
    if not os.path.exists(target_file):
        return False, 0.0, 0.0, f"Quota state file not found at {target_file}"

    refresh_note = ""
    if agent == "agy" and current_time is None and _is_live_agy_observation(target_file):
        try:
            age_minutes = int((time.time() - os.path.getmtime(target_file)) / 60)
        except OSError:
            age_minutes = 0
        if age_minutes > STALE_OBSERVATION_MINUTES:
            refreshed, detail = refresh_agy_observation(target_file)
            if not refreshed:
                refresh_note = f" [auto-refresh failed: {detail}; {AGY_REFRESH_HINT}]"

    try:
        with open(target_file, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        return False, 0.0, 0.0, f"Failed to parse quota state for {agent}: {e}"

    if current_time is None:
        current_time = time.time()

    # Both agy and codex observations have windows either at top level or under snapshot
    windows = data.get("windows") or data.get("snapshot", {}).get("windows") or []
    rem_5h = None
    rem_weekly = None
    for w in windows:
        if w.get("kind") == "five_hour":
            rem_val = float(w.get("remaining_percent", 0.0))
            resets_at_ts = _parse_resets_at(w.get("resets_at"))
            if resets_at_ts is not None and current_time > resets_at_ts:
                rem_val = 100.0
            rem_5h = rem_val
        elif w.get("kind") == "weekly":
            rem_val = float(w.get("remaining_percent", 0.0))
            resets_at_ts = _parse_resets_at(w.get("resets_at"))
            if resets_at_ts is not None and current_time > resets_at_ts:
                rem_val = 100.0
            rem_weekly = rem_val

    # Fallback to payload.quota (Gemini structure) if snapshot windows missing
    if rem_5h is None or rem_weekly is None:
        quota = data.get("payload", {}).get("quota", {})
        if rem_5h is None and "gemini-5h" in quota:
            g5 = quota["gemini-5h"]
            rem_val = float(g5.get("remaining_fraction", 0.0)) * 100.0
            resets_at_ts = _parse_resets_at(g5.get("reset_time") or g5.get("resets_at"))
            if resets_at_ts is not None and current_time > resets_at_ts:
                rem_val = 100.0
            rem_5h = rem_val
        if rem_weekly is None and "gemini-weekly" in quota:
            gw = quota["gemini-weekly"]
            rem_val = float(gw.get("remaining_fraction", 0.0)) * 100.0
            resets_at_ts = _parse_resets_at(gw.get("reset_time") or gw.get("resets_at"))
            if resets_at_ts is not None and current_time > resets_at_ts:
                rem_val = 100.0
            rem_weekly = rem_val

    if rem_5h is None or rem_weekly is None:
        return False, 0.0, 0.0, f"Could not locate 5h or weekly window in {target_file}"

    eligible = (rem_5h >= min_5h) and (rem_weekly >= min_weekly)
    stale_suffix = ""
    try:
        mtime = os.path.getmtime(target_file)
        age_minutes = int((current_time - mtime) / 60)
        if age_minutes > STALE_OBSERVATION_MINUTES:
            eligible = False
            stale_suffix = (f" [stale: observation {age_minutes}m old, over {STALE_OBSERVATION_MINUTES}m"
                            f" - not eligible until the quota telemetry refreshes]")
    except Exception:
        pass

    msg = f"[{agent.upper()}] 5h: {rem_5h:.1f}% (min {min_5h:.1f}%), Weekly: {rem_weekly:.1f}% (min {min_weekly:.1f}%){stale_suffix}"
    if stale_suffix:
        msg += refresh_note
    return eligible, rem_5h, rem_weekly, msg


def calculate_runway(rem_5h, rem_weekly, min_5h=DEFAULT_MIN_5H, min_weekly=DEFAULT_MIN_WEEKLY):
    """Calculates runway score = min(5h_remaining - min_5h, weekly_remaining - min_weekly)"""
    return min(rem_5h - min_5h, rem_weekly - min_weekly)


def route_best_agent(min_5h=DEFAULT_MIN_5H, min_weekly=DEFAULT_MIN_WEEKLY, agy_state_file=None, codex_state_file=None, current_time=None):
    """
    Evaluates both agy and codex runway scores.
    runway = min(5h_remaining - min_5h, weekly_remaining - min_weekly)
    Picks the agent with the higher runway score.
    Returns: (chosen_agent, eligible, rem_5h, rem_weekly, msg)
    An agent check_quota marks ineligible (low quota, stale or missing observation) is never chosen.
    If neither is eligible, eligible is False.
    With codex in DISABLED_AGENTS, agy is the only candidate and codex quota is never read.
    """
    el_a, r5_a, rw_a, msg_a = check_quota("agy", agy_state_file, min_5h, min_weekly, current_time=current_time)
    if "codex" in DISABLED_AGENTS:
        return "agy", el_a, r5_a, rw_a, msg_a
    el_c, r5_c, rw_c, msg_c = check_quota("codex", codex_state_file, min_5h, min_weekly, current_time=current_time)

    runway_a = calculate_runway(r5_a, rw_a, min_5h, min_weekly) if (r5_a is not None and rw_a is not None) else float("-inf")
    runway_c = calculate_runway(r5_c, rw_c, min_5h, min_weekly) if (r5_c is not None and rw_c is not None) else float("-inf")

    if not el_a and not el_c:
        msg = f"Auto routing failed (insufficient runway): agy runway={runway_a:.1f} ({msg_a}) | codex runway={runway_c:.1f} ({msg_c})"
        # Return higher of the two or agy by default
        if runway_c > runway_a:
            return "codex", False, r5_c, rw_c, msg
        return "agy", False, r5_a, rw_a, msg

    if el_a and (not el_c or runway_a >= runway_c):
        msg = f"{msg_a} (runway: {runway_a:.1f} vs codex {runway_c:.1f})"
        return "agy", True, r5_a, rw_a, msg
    else:
        msg = f"{msg_c} (runway: {runway_c:.1f} vs agy {runway_a:.1f})"
        return "codex", True, r5_c, rw_c, msg


def normalize_agent_name(name):
    clean = name.strip().lower()
    if clean in ("agy", "gemini", "antigravity"):
        return "agy"
    if clean in ("codex", "openai"):
        return "codex"
    if clean in ("cursor", "cursor-agent"):
        return "cursor"
    if clean in ("claude", "anthropic"):
        return "claude"
    return clean


def normalize_model_name(agent, model):
    if not model:
        if agent == "codex":
            return DEFAULT_CODEX_MODEL
        return None
    clean = model.strip()
    if agent == "codex":
        if clean.lower() in ("terra", "terra:5.6", "5.6"):
            return "gpt-5.6-terra"
        if clean.lower() in ("sol", "sol:5.6", "thinking"):
            return DEFAULT_CODEX_THINK_MODEL
    if agent == "claude" and clean.lower() == "opus":
        return DEFAULT_CLAUDE_THINK_MODEL
    if agent == "agy":
        if clean.lower() in ("argon", "gemini-4-argon", "gemini-4-argon-thinking"):
            return DEFAULT_AGY_THINK_MODEL
        if clean.lower() in ("flash", "3.8-flash", "gemini-3.8-flash", "gemini-3.8-flash-high"):
            return DEFAULT_AGY_WORKER_MODEL
    return clean


def normalize_effort(agent, effort):
    if not effort:
        return None
    clean = str(effort).strip().lower()
    if agent == "codex":
        # Codex model_reasoning_effort standard values: low, medium, high
        if clean in ("max", "xhigh"):
            return "high"
        return clean
    if agent == "agy":
        # agy CLI supports low, medium, high, max
        if clean == "xhigh":
            return "high"
        return clean
    if agent == "cursor":
        # cursor-agent CLI does not have an effort option
        return None
    return clean


def resolve_agent_effort(agent, effort, is_thinking=False):
    if is_thinking:
        if agent == "claude" and os.environ.get("CLAUDE_THINK_EFFORT"):
            effort = os.environ.get("CLAUDE_THINK_EFFORT")
        elif agent == "codex" and os.environ.get("CODEX_THINK_EFFORT"):
            effort = os.environ.get("CODEX_THINK_EFFORT")
        elif agent == "agy" and os.environ.get("AGY_THINK_EFFORT"):
            effort = os.environ.get("AGY_THINK_EFFORT")
    if not effort:
        return None
    return normalize_effort(agent, effort)


def parse_priority_chain(chain_str):
    """
    Parses strings like 'cursor:gemini-3.8-flash > agy > codex' or 'claude:claude-opus-5-5,agy:gemini-4-argon'
    Returns list of tuples: [(agent, model), ...]
    """
    if not chain_str or not chain_str.strip():
        return []
    raw_items = chain_str.split(">") if ">" in chain_str else chain_str.split(",")
    items = [item.strip() for item in raw_items if item.strip()]
    chain = []
    for item in items:
        if ":" in item:
            parts = item.split(":", 1)
            agent_raw = parts[0].strip()
            model_raw = parts[1].strip()
        else:
            agent_raw = item.strip()
            model_raw = None
        agent = normalize_agent_name(agent_raw)
        model = normalize_model_name(agent, model_raw)
        chain.append((agent, model))
    return chain


def drop_disabled_agents(chain):
    """Splits a parsed chain into (entries that may be routed to, names of the disabled agents it listed)."""
    kept = [c for c in chain if c[0] not in DISABLED_AGENTS]
    dropped = sorted({c[0] for c in chain if c[0] in DISABLED_AGENTS})
    return kept, dropped


def route_priority_chain(chain, allow_on_demand=False, min_5h=DEFAULT_MIN_5H, min_weekly=DEFAULT_MIN_WEEKLY, agy_state_file=None, codex_state_file=None, current_time=None):
    """
    Evaluates each candidate in chain in priority order.
    Returns: (chosen_agent, chosen_model, eligible, rem_5h, rem_weekly, msg)
    """
    traces = []
    for agent, model in chain:
        if agent in DISABLED_AGENTS:
            traces.append(f"{agent}: disabled")
            continue
        if agent == "cursor":
            if not allow_on_demand:
                traces.append("cursor: skipped (on-demand disallowed)")
                continue
            el, r5, rw, msg = check_quota("cursor", current_time=current_time)
            if el:
                model_str = f" with {model}" if model else ""
                traces.append(f"cursor: selected{model_str}")
                return "cursor", model, True, r5, rw, f"{msg}{model_str}"
            else:
                traces.append(f"cursor: unavailable ({msg})")
        elif agent in ("agy", "codex", "claude"):
            state_file = agy_state_file if agent == "agy" else codex_state_file
            el, r5, rw, msg = check_quota(agent, state_file, min_5h, min_weekly, current_time=current_time)
            if el:
                model_str = f" with {model}" if model else ""
                traces.append(f"{agent}: selected{model_str}")
                return agent, model, True, r5, rw, f"{msg}{model_str}"
            else:
                traces.append(f"{agent}: quota low ({msg})")
        else:
            traces.append(f"{agent}: unknown agent")

    summary = " -> ".join(traces)
    fb_agent = chain[0][0] if chain else "auto"
    fb_model = chain[0][1] if chain else None
    return fb_agent, fb_model, False, 0.0, 0.0, f"Chain exhausted: {summary}"


def route_execution_fallback(chosen_agent, chain=None, allow_on_demand=False, min_5h=DEFAULT_MIN_5H,
                             min_weekly=DEFAULT_MIN_WEEKLY, agy_state_file=None, codex_state_file=None, current_time=None):
    """
    Runtime fallback for a routed (non-think) task: the next eligible (agent, model) other than chosen_agent,
    drawn from the priority chain, or from agy/codex for --agent auto. None when no other candidate is eligible.
    """
    candidates = [c for c in (chain or [("agy", None), ("codex", None)])
                  if c[0] != chosen_agent and c[0] not in DISABLED_AGENTS]
    if not candidates:
        return None
    agent, model, eligible, _r5, _rw, _msg = route_priority_chain(
        candidates, allow_on_demand=allow_on_demand, min_5h=min_5h, min_weekly=min_weekly,
        agy_state_file=agy_state_file, codex_state_file=codex_state_file, current_time=current_time,
    )
    return (agent, model) if eligible else None


CLAUDE_THINK_MODEL_NAMES = ("claude-opus-5-5", "opus")


def route_thinker(model=None, codex_state_file=None, min_5h=DEFAULT_THINK_MIN_5H, min_weekly=DEFAULT_THINK_MIN_WEEKLY,
                  current_time=None, agy_state_file=None, priority=None):
    """
    Thinking-mode chain: Claude Opus 5.5 and Gemini 4 Argon under think quota.
    When a priority chain is specified (e.g. 'claude:claude-opus-5-5,agy:gemini-4-argon' or
    'agy:gemini-4-argon > claude:claude-opus-5-5'), candidates are evaluated in that priority order.
    An explicit model pins its provider (Claude-family -> claude only, AGY-family -> agy only).
    Returns: (agent, model, eligible, rem_5h, rem_weekly, msg, runtime_fallback), where runtime_fallback is the
    next eligible (agent, model) to retry once if the chosen agent's run fails, else None.
    """
    chain_pref = priority or os.environ.get("DISPATCH_THINK_PREFERENCE")
    candidates = []
    if chain_pref and model is None:
        parsed_chain = parse_priority_chain(chain_pref)
        for cand_agent, cand_model in parsed_chain:
            if cand_agent in DISABLED_AGENTS:
                continue
            if cand_agent == "claude":
                m = normalize_model_name("claude", cand_model) or DEFAULT_CLAUDE_THINK_MODEL
                if m.lower() in CLAUDE_THINK_MODEL_NAMES:
                    candidates.append(("claude", m))
                elif cand_model:
                    return "claude", cand_model, False, 0.0, 0.0, f"model '{cand_model}' is not an allowed thinking model for claude", None
            elif cand_agent == "agy":
                m = normalize_model_name("agy", cand_model) or DEFAULT_AGY_THINK_MODEL
                if m.lower() in AGY_THINK_MODEL_NAMES:
                    candidates.append(("agy", m))
                elif cand_model:
                    return "agy", cand_model, False, 0.0, 0.0, f"model '{cand_model}' is not an allowed thinking model for agy", None
            elif cand_agent == "codex" and "codex" not in DISABLED_AGENTS:
                m = normalize_model_name("codex", cand_model) or DEFAULT_CODEX_THINK_MODEL
                if m.lower() in ("gpt-5.6-sol", "sol"):
                    candidates.append(("codex", m))
                elif cand_model:
                    return "codex", cand_model, False, 0.0, 0.0, f"model '{cand_model}' is not an allowed thinking model for codex", None
    elif model is not None:
        if model.lower() in CLAUDE_THINK_MODEL_NAMES:
            candidates.append(("claude", normalize_model_name("claude", model) or DEFAULT_CLAUDE_THINK_MODEL))
        elif model.lower() in AGY_THINK_MODEL_NAMES:
            candidates.append(("agy", normalize_model_name("agy", model) or DEFAULT_AGY_THINK_MODEL))
        elif "codex" not in DISABLED_AGENTS and model.lower() in ("gpt-5.6-sol", "sol"):
            candidates.append(("codex", normalize_model_name("codex", model) or DEFAULT_CODEX_THINK_MODEL))
        else:
            return "claude", model, False, 0.0, 0.0, f"model '{model}' is not an allowed thinking model", None
    else:
        # Default thinker candidate when no chain preference is given: Claude Opus 5.5
        candidates.append(("claude", DEFAULT_CLAUDE_THINK_MODEL))
        if "codex" not in DISABLED_AGENTS:
            candidates.append(("codex", DEFAULT_CODEX_THINK_MODEL))

    if not candidates:
        return "claude", model, False, 0.0, 0.0, f"no eligible thinking candidates for model '{model}'", None

    eligible_picks = []
    traces = []
    for agent, agent_model in candidates:
        if agent == "codex":
            state_file = codex_state_file
        elif agent == "agy":
            state_file = agy_state_file
        else:
            state_file = None
        el, r5, rw, msg = check_quota(agent, state_file, min_5h, min_weekly, current_time=current_time)
        traces.append(msg)
        if el:
            eligible_picks.append((agent, agent_model, r5, rw, msg))

    if not eligible_picks:
        agent, agent_model = candidates[0]
        return agent, agent_model, False, 0.0, 0.0, "; ".join(traces), None
    agent, agent_model, r5, rw, msg = eligible_picks[0]
    fallback = eligible_picks[1][:2] if len(eligible_picks) > 1 else None
    return agent, agent_model, True, r5, rw, msg, fallback


def git_status_entries(target_dir):
    """`git status --porcelain` lines with untracked files expanded, or None when git status is unavailable."""
    try:
        proc = subprocess.run(["git", "status", "--porcelain", "--untracked-files=all"],
                              cwd=target_dir, capture_output=True, text=True, timeout=30)
    except Exception:
        return None
    if proc.returncode != 0:
        return None
    return {line for line in proc.stdout.splitlines() if line.strip()}


def _stat_signature(target_dir, path):
    """(size, mtime_ns) of a regular file; a marker for non-regular or unstat-able paths. Never reads file content."""
    try:
        st = os.lstat(os.path.join(target_dir, path))
    except OSError:
        return ("missing",)
    if not stat.S_ISREG(st.st_mode):
        return ("non-regular",)
    return (st.st_size, st.st_mtime_ns)


def git_baseline(target_dir):
    """{path: stat signature} of everything `git status -z` shows now, or None when git status is unavailable."""
    try:
        proc = subprocess.run(["git", "status", "--porcelain", "-z", "--untracked-files=all"],
                              cwd=target_dir, capture_output=True, text=True, errors="replace", timeout=10)
    except Exception:
        return None
    if proc.returncode != 0:
        return None
    fields = proc.stdout.split("\0")
    paths = []
    i = 0
    while i < len(fields):
        entry = fields[i]
        i += 1
        if len(entry) < 4:
            continue
        paths.append(entry[3:])
        if entry[0] in "RC":
            i += 1  # the rename/copy source follows as its own field
    return {p: _stat_signature(target_dir, p) for p in paths}


def changes_left_behind(target_dir, before, ignore_path=None):
    """Paths whose git status changed since `before`, minus `ignore_path`. None if status can't be compared."""
    after = git_status_entries(target_dir)
    if before is None or after is None:
        return None
    paths = sorted({line[3:] for line in after - before})
    if ignore_path:
        paths = [p for p in paths if os.path.abspath(os.path.join(target_dir, p)) != ignore_path]
    return paths


def git_head(target_dir):
    """HEAD commit of target_dir, or None when it can't be read."""
    try:
        proc = subprocess.run(["git", "rev-parse", "HEAD"], cwd=target_dir, capture_output=True, text=True, timeout=30)
    except Exception:
        return None
    return proc.stdout.strip() if proc.returncode == 0 else None


def fallback_refusal(diff_summary, left, head_moved):
    """
    Why a failed run must not be retried on the fallback agent, or None when the retry is safe.
    `left` is changes_left_behind() for the base tree; an isolated run that fails after a partial merge or copy
    has touched that tree just like a non-isolated one, so the same checks apply to both.
    """
    if (diff_summary or "").startswith("MERGE_CONFLICT"):
        return "hit a merge conflict after its work was partly applied"
    if left is None:
        return "git status could not be compared"
    if head_moved:
        return "HEAD moved (it committed or merged work)"
    if left:
        return "left changes behind that must not be attributed to the fallback:\n  " + "\n  ".join(left)
    return None


def build_context_block(context_paths, max_lines_per_file=300):
    """
    Builds a structured context section referencing files or directories.
    For files, embeds relative path and header/content if feasible, or points the worker to read them directly.
    """
    if not context_paths:
        return ""
    blocks = ["\nContext & Reference Documents:"]
    for path_str in context_paths:
        p = Path(path_str)
        if not p.exists():
            blocks.append(f"- [NOT_FOUND] {path_str}")
            continue
        if p.is_file():
            blocks.append(f"\n--- Context Document: {p.name} ({path_str}) ---")
            try:
                content = p.read_text(encoding="utf-8", errors="replace")
                lines = content.splitlines()
                if len(lines) > max_lines_per_file:
                    preview = "\n".join(lines[:max_lines_per_file])
                    blocks.append(f"{preview}\n... [TRUNCATED: {len(lines) - max_lines_per_file} more lines in {path_str}. Read directly if needed.]")
                else:
                    blocks.append(content)
            except Exception as err:
                blocks.append(f"(Could not read file inline: {err}. Please inspect '{path_str}' directly on disk.)")
        elif p.is_dir():
            blocks.append(f"\n--- Context Directory: {path_str} ---")
            blocks.append("Files in directory:")
            try:
                for child in sorted(p.iterdir())[:20]:
                    blocks.append(f"  - {child.name} ({'dir' if child.is_dir() else 'file'})")
            except Exception as err:
                blocks.append(f"  (Error listing directory: {err})")
    blocks.append("\nInstructions regarding Context:")
    blocks.append("Do NOT overwrite or delete reference documents unless explicitly instructed.")
    return "\n".join(blocks) + "\n"


def wrap_prompt_contract(task_prompt, context_files=None, output_file=None, is_thinking=False,
                         verify_cmd=None, acceptance=None):
    """
    Wraps task prompt with standard standing rules:
    - Test-Driven Development (TDD) (for implementation) or Rigorous Reasoning (for thinking)
    - Make new commits only (never git commit --amend)
    - Preserve protected config files
    - Scoped Verification (targeted tests only)
    - Context bundling and output file destination
    """
    if verify_cmd:
        gate_rule = (
            f"Before declaring completion, run the repo's gate command `{verify_cmd}` from the repo root and paste its final "
            "lines in your reply. The dispatcher re-runs this exact command after you exit and will NOT merge your work if it fails."
        )
    else:
        gate_rule = (
            "Before declaring completion, run the repo's full gate or test command (including end-to-end / UI suites when "
            "your change touches them) and paste its final lines in your reply."
        )

    if is_thinking:
        contract_header = (
            "Standing Rules & Prompt Contract (Thinking / Architecture Mode):\n"
            "1. Deep Analysis & Verification: Reason carefully about edge cases, backward compatibility, performance, and failure modes.\n"
            "2. Preserve protected config files: Do NOT overwrite or delete protected configuration files "
            "(.release.json, working-feature.json, claims.json, or git internal state).\n"
            "3. Structured Deliverables: Provide actionable, unambiguous recommendations, task breakdowns, or code diffs.\n"
        )
    else:
        contract_header = (
            "Standing Rules & Prompt Contract:\n"
            "1. Test-Driven Development (TDD): Write tests first (RED), implement functionality (GREEN), then refactor.\n"
            "2. Make new commits only: Never git commit --amend. Always create fresh commits to keep git history honest.\n"
            "3. Preserve protected config files: Do NOT overwrite or delete protected configuration files "
            "(.release.json, working-feature.json, claims.json, or git internal state).\n"
            "4. Evidence before assertions & Scoped Verification: Run TARGETED unit tests or build commands for the touched "
            "files/modules (e.g. pytest path/to/test.py, npm test -- specific.test.ts) while iterating. "
            f"{gate_rule}\n"
            "5. NO CSS/Class Invention (Visual Integrity): When writing HTML, JSX, Svelte, or Vue markup, NEVER invent class "
            "names or Tailwind utilities that do not exist in the project's CSS/tokens. Always verify defined classes directly in the "
            "theme or component source before applying them.\n"
        )

    context_section = build_context_block(context_files) if context_files else ""
    output_section = ""
    if output_file:
        output_section = (
            f"\nArtifact Output Requirement:\n"
            f"Write your primary output/deliverable directly to the file: '{output_file}'. "
            f"Ensure parent directories exist if necessary.\n"
        )

    acceptance_section = ""
    if acceptance and acceptance.strip():
        acceptance_section = (
            "\nAcceptance criteria:\n"
            "The work is done only when every item below holds. State how you checked each one.\n"
            f"{acceptance.strip()}\n"
        )

    return f"{contract_header}{context_section}{output_section}{acceptance_section}\nTask Brief:\n{task_prompt.strip()}"


def inspect_git_changes(target_dir, initial_head=None, baseline=None):
    """
    Inspects target_dir for commits, modified files, and untracked files relative to initial_head.
    With `baseline` (git_baseline() taken before the job), paths already dirty then and unchanged since are not counted
    (an empty baseline is valid: a clean tree).
    Returns: (files_changed, diff_summary, commit_count)
    """
    commit_count = 0
    if initial_head:
        commits_res = subprocess.run(
            ["git", "log", "--oneline", f"{initial_head}..HEAD"],
            cwd=target_dir,
            capture_output=True,
            text=True,
        )
        commit_lines = [line.strip() for line in commits_res.stdout.splitlines() if line.strip()]
        commit_count = len(commit_lines)

    diff_stat_args = ["git", "diff", "--stat", initial_head] if initial_head else ["git", "diff", "--stat"]
    diff_stat = subprocess.run(
        diff_stat_args,
        cwd=target_dir,
        capture_output=True,
        text=True,
    ).stdout.strip()
    stat_summary = diff_stat.splitlines()[-1] if diff_stat else "no git diff"

    if commit_count > 0 and stat_summary != "no git diff":
        diff_summary = f"{commit_count} commit(s), {stat_summary}"
    elif commit_count > 0:
        diff_summary = f"{commit_count} commit(s)"
    else:
        diff_summary = stat_summary

    diff_name_args = ["git", "diff", "--name-only", "-z", initial_head] if initial_head else ["git", "diff", "--name-only", "-z"]
    files_changed_res = subprocess.run(
        diff_name_args,
        cwd=target_dir,
        capture_output=True,
        text=True,
    ).stdout.strip()

    untracked_res = subprocess.run(
        ["git", "ls-files", "--others", "--exclude-standard", "-z"],
        cwd=target_dir,
        capture_output=True,
        text=True,
    ).stdout.strip()

    all_changed = set([f for f in files_changed_res.split("\0") if f] + [f for f in untracked_res.split("\0") if f])
    if baseline is not None:
        all_changed = {f for f in all_changed if f not in baseline or _stat_signature(target_dir, f) != baseline[f]}
    files_changed = len(all_changed)

    return files_changed, diff_summary, commit_count


def execute_worker_process(cmd, target_dir, timeout_seconds, agent_name="worker", log_path=None,
                           stream_state=None, idle_seconds=None, on_conversation_id=None):
    """
    Executes worker subprocess in target_dir with timeout.
    Returns: (exit_code, stdout, stderr, is_timeout)
    The worker gets its own process group so a timeout kills the whole tree, and partial output is kept.
    With log_path, stdout/stderr lines are also appended to that file as they arrive (live --tail / --status).
    stream_kw (agy stream-json runs): stream_state (dict filled with conversation_id, result, timeout_kind),
    idle_seconds (kill after this long without an event) and on_conversation_id (callback).
    """
    try:
        proc = subprocess.Popen(
            cmd,
            cwd=target_dir,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            errors="replace",
            start_new_session=True,
        )
    except Exception as e:
        return 1, "", f"FAILED: error launching {agent_name}: {e}", False

    log_fh = None
    if log_path:
        try:
            Path(log_path).parent.mkdir(parents=True, exist_ok=True)
            log_fh = open(log_path, "a", encoding="utf-8", errors="replace")
        except OSError:
            log_fh = None
    log_lock = threading.Lock()
    chunks = {"out": [], "err": []}
    if stream_state is not None:
        stream_state["last_event"] = time.monotonic()
    last_beat = [0.0]

    def _log(line):
        if log_fh:
            with log_lock:
                try:
                    log_fh.write(line)
                    log_fh.flush()
                except (OSError, ValueError):
                    pass

    def _stream_event(rec):
        """Handles one agy stream-json event: remembers the conversation id and result, logs a throttled heartbeat."""
        kind = rec.get("event")
        payload = rec.get(kind) if isinstance(rec.get(kind), dict) else {}
        cid = payload.get("conversation_id") or rec.get("conversation_id")
        if isinstance(cid, str) and cid and not stream_state.get("conversation_id"):
            stream_state["conversation_id"] = cid
            _log(f"[agy] conversation_id={cid}\n")
            if on_conversation_id:
                try:
                    on_conversation_id(cid)
                except Exception as e:
                    print(f"[dispatch-worker] warning: could not persist conversation_id: {e}", file=sys.stderr)
        if kind == "result":
            stream_state["result"] = payload
            _log(f"[agy] result status={payload.get('status')} turns={payload.get('num_turns')}\n")
            return
        if kind == "step_update":
            stream_state["last_step"] = f"step {payload.get('step_index')} {payload.get('step_type')} state={payload.get('state')}"
            if time.monotonic() - last_beat[0] >= HEARTBEAT_SECONDS:
                last_beat[0] = time.monotonic()
                _log(f"[agy] {stream_state['last_step']}\n")
        if kind not in ("init", "step_update") or "error" in payload:
            # Anything else (errors, warnings): keep a bounded tail so a killed run still says something.
            stream_state.setdefault("notes", collections.deque(maxlen=STREAM_NOTE_LINES)).append(
                json.dumps(rec, default=str)[:STREAM_NOTE_CHARS])

    def _pump(pipe, key):
        # One reader per pipe so neither can fill up and deadlock the worker.
        for line in iter(pipe.readline, ""):
            if stream_state is not None and key == "out":
                stream_state["last_event"] = time.monotonic()
                try:
                    rec = json.loads(line)
                except (ValueError, RecursionError):
                    rec = None
                if isinstance(rec, dict) and isinstance(rec.get("event"), str):
                    _stream_event(rec)
                    continue
            chunks[key].append(line)
            _log(line)

    readers = [threading.Thread(target=_pump, args=(proc.stdout, "out"), daemon=True),
               threading.Thread(target=_pump, args=(proc.stderr, "err"), daemon=True)]
    for r in readers:
        r.start()

    is_timeout = False
    try:
        if stream_state is None or not idle_seconds:
            proc.wait(timeout=timeout_seconds)
        else:
            # Hard wall-clock cap plus a no-activity limit: whichever trips first kills the worker.
            deadline = time.monotonic() + timeout_seconds
            last_files = git_baseline(target_dir)  # folder state at the previous idle check
            while True:
                now = time.monotonic()
                if now >= deadline:
                    stream_state["timeout_kind"] = "wall"
                    raise subprocess.TimeoutExpired(cmd, timeout_seconds)
                if now - stream_state["last_event"] >= idle_seconds:
                    # Quiet is not stuck: a long tool step emits nothing but may still be editing files.
                    files_now = git_baseline(target_dir)
                    if files_now is not None and last_files is not None and files_now != last_files:
                        last_files = files_now
                        stream_state["last_event"] = time.monotonic()
                        continue
                    stream_state["timeout_kind"] = "idle"
                    raise subprocess.TimeoutExpired(cmd, idle_seconds)
                try:
                    proc.wait(timeout=max(0.01, min(0.25, deadline - now)))
                    break
                except subprocess.TimeoutExpired:
                    continue
    except subprocess.TimeoutExpired:
        is_timeout = True
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            proc.kill()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
    # Bounded drain, also after a normal exit: a descendant the worker left behind may still hold the pipes.
    def _drain(seconds):
        deadline = time.monotonic() + seconds
        for r in readers:
            r.join(timeout=max(0.0, deadline - time.monotonic()))
        return not any(r.is_alive() for r in readers)

    if not is_timeout and not _drain(1):
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
    # A descendant that escaped the process group may still hold the pipes; give up on the rest.
    _drain(5 if is_timeout else 2)
    if log_fh:
        with log_lock:
            log_fh.close()
    out, err = "".join(chunks["out"]), "".join(chunks["err"])
    if stream_state is not None:
        result = stream_state.get("result")
        if isinstance(result, dict):
            response = result.get("response")
            if response is not None and not isinstance(response, str):
                stream_state["bad_response"] = True
                response = json.dumps(response, default=str)
            out = response if response is not None else out
            if is_timeout and result.get("status") == "SUCCESS":
                # The run finished and only lingered: the kill ended a finished run, it did not time one out.
                return 0, out.strip(), err.strip(), False
        else:
            evidence = [f"[agy] no result event; last {stream_state['last_step']}"] if stream_state.get("last_step") else []
            evidence += list(stream_state.get("notes", []))
            out = "\n".join(filter(None, [out.strip()] + evidence))
    if not is_timeout:
        return proc.returncode, out.strip(), err.strip(), False
    if stream_state is not None and stream_state.get("timeout_kind") == "idle":
        timeout_msg = f"FAILED: {agent_name} idle for {idle_seconds:g}s (no events); killed."
        combined_err = f"{timeout_msg}\n{err}".strip() if err else timeout_msg
        return 124, out.strip(), combined_err.strip(), True
    timeout_msg = f"FAILED: {agent_name} timed out after {timeout_seconds}s."
    combined_err = f"{timeout_msg}\n{err}".strip() if err else timeout_msg
    return 124, out.strip(), combined_err.strip(), True


def resolve_verify_cmd(target_dir, verify_cmd=None, no_verify=False):
    """
    Picks the verify command for target_dir. Returns (cmd_or_None, source), source being one of:
    "disabled" (--no-verify), "explicit" (--verify-cmd), "default" (scripts/precheck.sh), "none".
    """
    if no_verify:
        return None, "disabled"
    if verify_cmd and verify_cmd.strip():
        return verify_cmd.strip(), "explicit"
    script = Path(target_dir) / DEFAULT_VERIFY_SCRIPT
    if script.is_file() and os.access(script, os.X_OK):
        return f"./{DEFAULT_VERIFY_SCRIPT}", "default"
    return None, "none"


def run_verify_cmd(verify_cmd, target_dir, timeout_seconds):
    """
    Runs the verify shell command inside target_dir. Returns (ok, tail_output, is_timeout).
    A timeout is a failure. The command gets its own process group so a timeout kills the whole tree.
    """
    try:
        proc = subprocess.Popen(
            verify_cmd,
            shell=True,
            cwd=target_dir,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors="replace",
            start_new_session=True,
        )
    except Exception as e:
        return False, f"[verify] could not launch `{verify_cmd}`: {e}", False

    is_timeout = False
    try:
        output, _ = proc.communicate(timeout=timeout_seconds)
    except subprocess.TimeoutExpired:
        is_timeout = True
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            proc.kill()
        output, _ = proc.communicate()

    tail_lines = (output or "").splitlines()[-VERIFY_TAIL_LINES:]
    if is_timeout:
        tail_lines.append(f"[verify] `{verify_cmd}` timed out after {timeout_seconds}s")
    elif proc.returncode != 0:
        tail_lines.append(f"[verify] `{verify_cmd}` exited {proc.returncode}")
    return (not is_timeout and proc.returncode == 0), "\n".join(tail_lines), is_timeout


def execute_in_isolated_worktree(base_repo_dir, execute_fn, merge_lock=None):
    """
    Executes a callback inside a temporary git worktree:
    1. Cuts a temporary worktree via `git worktree add /tmp/worker-... HEAD`
    2. Runs execute_fn(worktree_dir)
    3. Merges/applies changes back on success (serialized if merge_lock provided)
    4. Always removes the worktree in a finally block
    """
    temp_worktree_dir = tempfile.mkdtemp(prefix="worker-", dir="/tmp")
    # mkdtemp creates the directory, but `git worktree add <path>` requires the path to not exist or be an empty dir
    # removing the dir so `git worktree add` can create it cleanly
    try:
        os.rmdir(temp_worktree_dir)
    except OSError:
        pass

    keep_worktree = False
    try:
        initial_base_head = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=base_repo_dir,
            capture_output=True,
            text=True,
        ).stdout.strip()

        # Create worktree off current HEAD
        add_res = subprocess.run(
            ["git", "worktree", "add", "--detach", temp_worktree_dir, "HEAD"],
            cwd=base_repo_dir,
            capture_output=True,
            text=True,
        )
        if add_res.returncode != 0:
            raise RuntimeError(f"Failed to create git worktree at {temp_worktree_dir}: {add_res.stderr.strip()}")

        exit_code, stdout, stderr, files_changed, diff_summary = execute_fn(temp_worktree_dir)

        if exit_code == VERIFY_FAILED_EXIT_CODE:
            # Never merged; left on disk so the failing state can be inspected and re-run.
            keep_worktree = True
            keep_msg = (
                f"[Verify] Nothing merged. Worktree left in place for inspection: {temp_worktree_dir} "
                f"(remove with: git -C {base_repo_dir} worktree remove --force {temp_worktree_dir})"
            )
            stderr = f"{stderr}\n{keep_msg}".strip()
            print(keep_msg, file=sys.stderr)

        lock_ctx = merge_lock if merge_lock is not None else nullcontext()
        with lock_ctx:
            if exit_code == 0:
                base_head_rev = subprocess.run(
                    ["git", "rev-parse", "HEAD"],
                    cwd=base_repo_dir,
                    capture_output=True,
                    text=True,
                ).stdout.strip()

                worktree_head = subprocess.run(
                    ["git", "rev-parse", "HEAD"],
                    cwd=temp_worktree_dir,
                    capture_output=True,
                    text=True,
                ).stdout.strip()

                # 1. If worktree created new commits, attempt fast-forward merge into base_repo_dir
                merged_commits = False
                if worktree_head and worktree_head != base_head_rev:
                    merge_res = subprocess.run(
                        ["git", "merge", "--ff-only", worktree_head],
                        cwd=base_repo_dir,
                        capture_output=True,
                        text=True,
                    )
                    if merge_res.returncode == 0:
                        merged_commits = True

                # 2. If commits were not merged, apply all committed changes as patch relative to initial_base_head
                if not merged_commits and worktree_head and worktree_head != initial_base_head:
                    diff_patch_res = subprocess.run(
                        ["git", "diff", f"{initial_base_head}..{worktree_head}"],
                        cwd=temp_worktree_dir,
                        capture_output=True,
                        text=True,
                    )
                    commit_patch = diff_patch_res.stdout
                    if commit_patch.strip():
                        apply_res = subprocess.run(
                            ["git", "apply", "--whitespace=nowarn", "-"],
                            input=commit_patch,
                            cwd=base_repo_dir,
                            capture_output=True,
                            text=True,
                        )
                        if apply_res.returncode == 0:
                            subprocess.run(["git", "add", "-A"], cwd=base_repo_dir, capture_output=True)
                            subprocess.run(
                                ["git", "commit", "-C", worktree_head],
                                cwd=base_repo_dir,
                                capture_output=True,
                                text=True,
                            )
                        else:
                            backup_patch = f"/tmp/worker-conflict-{int(time.time())}.patch"
                            try:
                                with open(backup_patch, "w", encoding="utf-8") as f:
                                    f.write(commit_patch)
                                print(f"Warning: git apply failed back to base repo: {apply_res.stderr.strip()}", file=sys.stderr)
                                print(f"Preserved unapplied worktree patch at: {backup_patch}", file=sys.stderr)
                            except Exception:
                                pass
                            exit_code = 1
                            stderr = f"FAILED: merge conflict applying patch to base repo: {apply_res.stderr.strip()}\nPreserved conflict patch at: {backup_patch}"
                            diff_summary = f"MERGE_CONFLICT (saved patch: {backup_patch})"

                # 3. Apply any uncommitted working tree changes from worktree
                wt_diff_res = subprocess.run(
                    ["git", "diff", "HEAD"],
                    cwd=temp_worktree_dir,
                    capture_output=True,
                    text=True,
                )
                uncommitted_patch = wt_diff_res.stdout
                if uncommitted_patch.strip():
                    apply_wt_res = subprocess.run(
                        ["git", "apply", "--whitespace=nowarn", "-"],
                        input=uncommitted_patch,
                        cwd=base_repo_dir,
                        capture_output=True,
                        text=True,
                    )
                    if apply_wt_res.returncode != 0:
                        backup_patch = f"/tmp/worker-conflict-uncommitted-{int(time.time())}.patch"
                        try:
                            with open(backup_patch, "w", encoding="utf-8") as f:
                                f.write(uncommitted_patch)
                            print(f"Warning: git apply failed back to base repo for uncommitted changes: {apply_wt_res.stderr.strip()}", file=sys.stderr)
                            print(f"Preserved unapplied worktree patch at: {backup_patch}", file=sys.stderr)
                        except Exception:
                            pass
                        exit_code = 1
                        stderr = f"FAILED: merge conflict applying uncommitted changes: {apply_wt_res.stderr.strip()}\nPreserved conflict patch at: {backup_patch}"
                        diff_summary = f"MERGE_CONFLICT (saved patch: {backup_patch})"

                # 4. Copy untracked files
                untracked_res = subprocess.run(
                    ["git", "ls-files", "--others", "--exclude-standard"],
                    cwd=temp_worktree_dir,
                    capture_output=True,
                    text=True,
                )
                untracked_files = [line.strip() for line in untracked_res.stdout.splitlines() if line.strip()]
                for rel_file in untracked_files:
                    src_path = Path(temp_worktree_dir) / rel_file
                    dst_path = Path(base_repo_dir) / rel_file
                    if src_path.is_file():
                        dst_path.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(src_path, dst_path)
            elif not keep_worktree:
                # Worker failed or timed out: salvage any partial work before removing worktree
                try:
                    base_head_rev = subprocess.run(
                        ["git", "rev-parse", "HEAD"],
                        cwd=base_repo_dir,
                        capture_output=True,
                        text=True,
                    ).stdout.strip()
                    worktree_head = subprocess.run(
                        ["git", "rev-parse", "HEAD"],
                        cwd=temp_worktree_dir,
                        capture_output=True,
                        text=True,
                    ).stdout.strip()

                    salvage_msgs = []
                    timestamp = int(time.time())

                    # 1. If worktree created new commits, preserve them on a dedicated salvage branch
                    if worktree_head and worktree_head != base_head_rev:
                        salvage_branch = f"worker-salvage-{timestamp}"
                        branch_res = subprocess.run(
                            ["git", "branch", salvage_branch, worktree_head],
                            cwd=base_repo_dir,
                            capture_output=True,
                            text=True,
                        )
                        if branch_res.returncode == 0:
                            salvage_msgs.append(f"[Salvage] Commits preserved on git branch '{salvage_branch}'")
                        else:
                            salvage_msgs.append(f"[Salvage] Failed to create branch '{salvage_branch}': {branch_res.stderr.strip()}")

                    # 2. If uncommitted changes or untracked files exist, preserve them as a patch
                    diff_patch_res = subprocess.run(
                        ["git", "diff", worktree_head or base_head_rev],
                        cwd=temp_worktree_dir,
                        capture_output=True,
                        text=True,
                    )
                    salvage_diff = diff_patch_res.stdout

                    untracked_res = subprocess.run(
                        ["git", "ls-files", "--others", "--exclude-standard"],
                        cwd=temp_worktree_dir,
                        capture_output=True,
                        text=True,
                    )
                    untracked_files = [line.strip() for line in untracked_res.stdout.splitlines() if line.strip()]

                    if salvage_diff.strip() or untracked_files:
                        salvage_patch = f"/tmp/worker-salvage-{timestamp}.patch"
                        with open(salvage_patch, "w", encoding="utf-8") as f:
                            f.write(f"# Salvage patch from worker execution (exit {exit_code})\n")
                            f.write(f"# Base HEAD: {base_head_rev}\n")
                            f.write(f"# Worktree HEAD: {worktree_head}\n\n")
                            if salvage_diff.strip():
                                f.write(salvage_diff)
                            if untracked_files:
                                f.write("\n# Untracked files:\n")
                                for u in untracked_files:
                                    u_path = Path(temp_worktree_dir) / u
                                    if u_path.is_file():
                                        try:
                                            content = u_path.read_text(encoding="utf-8")
                                            f.write(f"\n--- /dev/null\n+++ b/{u}\n@@ -0,0 +1,{len(content.splitlines())} @@\n")
                                            for line in content.splitlines():
                                                f.write(f"+{line}\n")
                                        except Exception:
                                            pass
                        salvage_msgs.append(f"[Salvage] Partial work preserved at {salvage_patch}")

                    if salvage_msgs:
                        combined_msg = "\n".join(salvage_msgs)
                        stderr = f"{stderr}\n{combined_msg}".strip() if stderr else combined_msg
                        print(combined_msg, file=sys.stderr)
                except Exception:
                    pass

        return exit_code, stdout, stderr, files_changed, diff_summary

    finally:
        # Cleanup worktree (unless verify failed: see keep_worktree above)
        if not keep_worktree:
            subprocess.run(
                ["git", "worktree", "remove", "--force", temp_worktree_dir],
                cwd=base_repo_dir,
                capture_output=True,
                text=True,
            )
            if os.path.exists(temp_worktree_dir):
                shutil.rmtree(temp_worktree_dir, ignore_errors=True)


def format_verified_line(verify_info=None):
    """One report line for the verify outcome: `Verified: true|false|skipped (<cmd or reason>)`."""
    info = verify_info or {}
    verified = info.get("verified", "skipped")
    label = {True: "true", False: "false"}.get(verified, "skipped")
    detail = info.get("verify_cmd") or ("--no-verify" if info.get("verify_source") == "disabled" else "no verify command")
    return f"Verified: {label} ({detail})"


def format_report(agent, status, exit_code, cwd, files_changed, diff_summary, tail_output, artifact=None, context_count=0,
                  verify_info=None):
    """Formats a concise <= 15 line report for thin orchestrators."""
    lines = [
        f"=== {agent.upper()} SUBAGENT REPORT ===",
        f"Status: {status} (exit {exit_code})",
        f"Directory: {cwd}",
    ]
    if artifact:
        lines.append(f"Artifact: {artifact}")
    if context_count > 0:
        lines.append(f"Context: {context_count} document(s) referenced")
    shared_note = " [shared folder: count not attributable to this job]" if (verify_info or {}).get("files_changed_shared") else ""
    if (verify_info or {}).get("baseline_unavailable"):
        shared_note += " [count not baseline-adjusted: git status failed at start]"
    lines.append(f"Files Modified: {files_changed} ({diff_summary}){shared_note}")
    lines.append(format_verified_line(verify_info))
    if (verify_info or {}).get("resumed"):
        lines.append("Resumed: true (killed once, continued with --conversation)")
    lines.append("Last Output:")
    out_lines = [line for line in tail_output.splitlines() if line.strip()]
    if not out_lines:
        lines.append("(no output)")
    else:
        remaining_slots = max(1, 14 - len(lines))
        lines.extend(out_lines[-remaining_slots:])
    lines.append("===========================")
    return "\n".join(lines[:15])


def get_config_mode(cfg):
    """
    Returns (mode_str, is_on_demand)
    mode_str: 'subscription_quota_remaining' | 'on_demand'
    """
    raw = (
        os.environ.get("AI_AGENT_AUTO_DISPATCH_SKILL_DISPATCH_MODE")
        or cfg.get("AI_AGENT_AUTO_DISPATCH_SKILL_DISPATCH_MODE")
        or os.environ.get("DISPATCH_MODE")
        or cfg.get("DISPATCH_MODE")
        or os.environ.get("DISPATCH_ALLOW_ON_DEMAND")
        or cfg.get("DISPATCH_ALLOW_ON_DEMAND")
        or "subscription_quota_remaining"
    )
    clean = str(raw).strip().lower()
    if clean in ("on_demand", "ondemand", "1", "true", "yes"):
        return "on_demand", True
    return "subscription_quota_remaining", False


def get_config_preference(cfg):
    return (
        os.environ.get("AI_AGENT_AUTO_DISPATCH_SKILL_DISPATCH_ROUTING_PREFERENCE")
        or cfg.get("AI_AGENT_AUTO_DISPATCH_SKILL_DISPATCH_ROUTING_PREFERENCE")
        or os.environ.get("DISPATCH_ROUTING_PREFERENCE")
        or cfg.get("DISPATCH_ROUTING_PREFERENCE")
    )


def get_config_timeout(cfg):
    raw = (
        os.environ.get("AI_AGENT_AUTO_DISPATCH_TIMEOUT")
        or cfg.get("AI_AGENT_AUTO_DISPATCH_TIMEOUT")
        or os.environ.get("DISPATCH_TIMEOUT")
        or cfg.get("DISPATCH_TIMEOUT")
        or str(DEFAULT_TIMEOUT)
    )
    try:
        return int(raw)
    except (ValueError, TypeError):
        return DEFAULT_TIMEOUT


def get_job_path(job_id, job_dir=DEFAULT_JOB_DIR):
    return Path(job_dir) / f"{job_id}.json"


def _atomic_write_json(path, data):
    """Writes through a uniquely named temp file, so concurrent writers never share or corrupt it."""
    temp_p = path.with_name(f"{path.name}.{os.getpid()}.{threading.get_ident()}.{os.urandom(3).hex()}.tmp")
    try:
        with open(temp_p, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
        temp_p.replace(path)
    finally:
        temp_p.unlink(missing_ok=True)


def conversation_sidecar_path(job_id, job_dir=DEFAULT_JOB_DIR):
    return Path(job_dir) / f"{job_id}.conversation"


def save_conversation_id(job_id, cid, job_dir=DEFAULT_JOB_DIR):
    """Records a job's agy conversation id in its own small file: the reader thread never rewrites the job JSON."""
    p = conversation_sidecar_path(job_id, job_dir)
    p.parent.mkdir(parents=True, exist_ok=True)
    _atomic_write_json(p, {"conversation_id": cid})


def save_job_state(job_id, state, job_dir=DEFAULT_JOB_DIR):
    p = get_job_path(job_id, job_dir)
    p.parent.mkdir(parents=True, exist_ok=True)
    _atomic_write_json(p, state)


def load_job_state(job_id, job_dir=DEFAULT_JOB_DIR):
    p = get_job_path(job_id, job_dir)
    if not p.is_file():
        return None
    try:
        with open(p, "r", encoding="utf-8") as f:
            state = json.load(f)
        if isinstance(state, dict):
            try:
                cid = json.loads(conversation_sidecar_path(job_id, job_dir).read_text(encoding="utf-8")).get("conversation_id")
            except (OSError, ValueError, AttributeError):
                cid = None
            if cid and not state.get("conversation_id"):
                state["conversation_id"] = cid
        return state
    except Exception:
        return None


def is_pid_running(pid):
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def list_all_jobs(job_dir=DEFAULT_JOB_DIR):
    p = Path(job_dir)
    if not p.is_dir():
        return []
    jobs = []
    for jf in sorted(p.glob("*.json")):
        data = load_job_state(jf.stem, job_dir)
        if data is not None:
            jobs.append(data)
    return jobs


CLAUDE_ALLOWED_TOOLS = "Read,Grep,Glob,Write,Edit"
CLAUDE_DISALLOWED_TOOLS = "Bash,WebFetch,WebSearch"


def build_agent_command(chosen_agent, chosen_model, wrapped_task, target_dir, output_file=None, effort=None,
                        conversation_id=None):
    if chosen_agent in DISABLED_AGENTS:
        raise ValueError(f"{chosen_agent} is disabled")
    if chosen_agent == "codex":
        model = chosen_model or DEFAULT_CODEX_MODEL
        cmd = [
            "codex", "exec",
            "-c", f"model=\"{model}\"",
        ]
        if effort:
            cmd.extend(["-c", f"model_reasoning_effort=\"{effort}\""])
        cmd.extend([
            "--dangerously-bypass-approvals-and-sandbox",
            wrapped_task
        ])
        return cmd
    elif chosen_agent == "claude":
        # Least privilege: read + Write/Edit only (the deliverable file), no shell or web access.
        # The tool/dir flags are variadic, so they take one comma-joined value each and never sit right before the prompt.
        dirs = [target_dir]
        if output_file:
            out_dir = os.path.dirname(os.path.abspath(os.path.join(target_dir, output_file)))
            if out_dir not in dirs:
                dirs.append(out_dir)
        cmd = ["claude", "-p", "--model", chosen_model or DEFAULT_CLAUDE_THINK_MODEL]
        if effort:
            cmd.extend(["--effort", effort])
        for d in dirs:
            cmd.extend(["--add-dir", d])
        cmd.extend([
            "--permission-mode", "acceptEdits",
            "--allowedTools", CLAUDE_ALLOWED_TOOLS,
            "--disallowedTools", CLAUDE_DISALLOWED_TOOLS,
            "--output-format", "text",
            wrapped_task,
        ])
        return cmd
    elif chosen_agent == "cursor":
        cmd = ["cursor-agent", "-p", "--yolo", "--trust"]
        if chosen_model:
            cmd.extend(["--model", chosen_model])
        cmd.append(wrapped_task)
        return cmd
    else:  # agy
        cmd = ["agy", "--add-dir", target_dir, "-p", wrapped_task, "--dangerously-skip-permissions",
               "--output-format", "stream-json"]
        if conversation_id:
            cmd.extend(["--conversation", conversation_id])
        if chosen_model:
            cmd.extend(["--model", chosen_model])
        if effort:
            cmd.extend(["--effort", effort])
        return cmd


def derive_status(exit_code, files_changed, verify_info=None):
    if exit_code == 0:
        # A resumed run lost its first turn's prompt once already: exit 0 alone does not prove it did the task.
        resumed_unproven = (verify_info is not None and verify_info.get("resumed")
                            and verify_info.get("verified") is not True)
        if resumed_unproven and (files_changed > 0 or verify_info.get("is_thinking") or verify_info.get("has_artifact")
                                 or not verify_info.get("in_git_repo", True)):
            return RESUMED_UNVERIFIED_STATUS
        if resumed_unproven:
            return NO_CHANGES_UNVERIFIED_STATUS
        # Read-only work stays SUCCESS when it is a thinking-mode task or wrote a non-empty --output-file.
        # Outside a git repo changed files cannot be counted, so "0 files" is not evidence either way.
        if (verify_info is not None and files_changed == 0 and verify_info.get("verified", "skipped") == "skipped"
                and not verify_info.get("is_thinking") and not verify_info.get("has_artifact")
                and verify_info.get("in_git_repo", True)):
            return NO_CHANGES_UNVERIFIED_STATUS
        return "SUCCESS"
    if exit_code == VERIFY_FAILED_EXIT_CODE:
        return "VERIFY_FAILED"
    if exit_code == 124:
        return "TIMEOUT_PARTIAL_WORK" if files_changed > 0 else "TIMEOUT_NO_PROGRESS"
    return "FAILED_PARTIAL_WORK" if files_changed > 0 else "FAILED"


def agy_idle_seconds():
    """No-event limit for agy runs (DISPATCH_AGY_IDLE_SECONDS); None when disabled by 0 or a negative value."""
    try:
        val = float(os.environ.get("DISPATCH_AGY_IDLE_SECONDS", DEFAULT_AGY_IDLE_SECONDS))
    except ValueError:
        val = float(DEFAULT_AGY_IDLE_SECONDS)
    return val if val > 0 else None


def build_resume_prompt(wrapped_task):
    """Prompt for `agy --conversation <id>`: the killed turn's prompt can be lost, so the whole task is repeated."""
    return (
        "NOTICE: your previous run on this task was killed before it finished. Inspect the existing work in the "
        "working tree first, keep everything already finished (do not redo or rewrite it), do not ask questions, "
        "and complete the rest of the task. Finish it fully. The full original task follows.\n\n"
        f"{wrapped_task}"
    )


def ends_with_question(text):
    return (text or "").rstrip().rstrip("\"'`*_)").endswith("?")


def verify_event_fields(info):
    """Event-log view of a run's verify plan: flags only - never the command or the acceptance text."""
    info = info or {}
    return {
        "has_verify_cmd": bool(info.get("verify_cmd")),
        "verify_source": info.get("verify_source"),
        "has_acceptance": bool(info.get("has_acceptance")),
        "verified": info.get("verified", "skipped"),
    }


def verify_opts_from(source):
    """Extracts the verify/acceptance options from a dict-like (batch item or job state)."""
    return {
        "verify_cmd": source.get("verify_cmd"),
        "no_verify": bool(source.get("no_verify", False)),
        "verify_timeout": source.get("verify_timeout") or DEFAULT_VERIFY_TIMEOUT,
        "acceptance": source.get("acceptance"),
    }


def run_single_task(task_text, target_dir, chosen_agent, chosen_model, timeout_seconds, context_files=None, output_file=None,
                    is_thinking=False, verify_opts=None, verify_info=None, effort=None, run_id=None, isolated=False,
                    log_path=None, on_conversation_id=None):
    """
    Runs the worker, then (worker exit 0 only) the verify command inside target_dir. On verify failure the same
    worker is re-invoked exactly once with the failure output; a second failure returns VERIFY_FAILED_EXIT_CODE,
    which keeps execute_in_isolated_worktree from merging. The verify outcome is written into `verify_info`.
    """
    opts = verify_opts or {}
    info = verify_info if verify_info is not None else {}
    verify_timeout = opts.get("verify_timeout") or DEFAULT_VERIFY_TIMEOUT
    # Thinking-mode tasks produce a document, not code: only an explicit --verify-cmd applies to them.
    verify_cmd, verify_source = resolve_verify_cmd(
        target_dir,
        verify_cmd=opts.get("verify_cmd"),
        no_verify=opts.get("no_verify", False) or (is_thinking and not opts.get("verify_cmd")),
    )
    info.update({
        "verified": "skipped", "verify_cmd": verify_cmd, "verify_source": verify_source,
        "verify_attempts": 0, "verify_output": "", "worktree": target_dir,
        "has_acceptance": bool((opts.get("acceptance") or "").strip()),
        "is_thinking": bool(is_thinking), "has_artifact": False,
        "resumed": False, "conversation_id": None, "timeout_kind": None,
    })
    if verify_source == "none":
        print(
            f"WARNING: result will be UNVERIFIED - no --verify-cmd given and no executable {DEFAULT_VERIFY_SCRIPT} in {target_dir}.",
            file=sys.stderr,
        )

    baseline = git_baseline(target_dir)
    initial_head = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=target_dir,
        capture_output=True,
        text=True,
    ).stdout.strip()
    info["in_git_repo"] = bool(initial_head)
    info["baseline_unavailable"] = bool(initial_head) and baseline is None

    def _artifact_signature():
        try:
            st = os.stat(os.path.join(target_dir, output_file))
            return (st.st_mtime_ns, st.st_size)
        except (OSError, TypeError):
            return None

    artifact_before = _artifact_signature()

    resume_used = []

    def _note_conversation(cid):
        info["conversation_id"] = cid
        if on_conversation_id:
            on_conversation_id(cid)

    def _run_agent(cmd, budget):
        """One worker process. An agy stream run is judged by its result event, not by its exit code alone."""
        stream = {} if "stream-json" in cmd else None
        if stream is None:
            result = execute_worker_process(cmd, target_dir, timeout_seconds=budget, agent_name=chosen_agent,
                                            log_path=log_path)
            if result[3]:
                emit_event("timeout", run_id=run_id, agent=chosen_agent, model=chosen_model, timeout=budget)
            return result, None
        code, out, err, timed_out = execute_worker_process(
            cmd, target_dir, timeout_seconds=budget, agent_name=chosen_agent, log_path=log_path,
            stream_state=stream, idle_seconds=agy_idle_seconds(), on_conversation_id=_note_conversation)
        if timed_out:
            info["timeout_kind"] = stream.get("timeout_kind", "wall")
            if info["timeout_kind"] == "idle":
                emit_event("idle_timeout", run_id=run_id, agent=chosen_agent, model=chosen_model,
                           idle_seconds=agy_idle_seconds(), conversation_id=stream.get("conversation_id"))
            else:
                emit_event("timeout", run_id=run_id, agent=chosen_agent, model=chosen_model, timeout=budget)
        elif code == 0:
            result = stream.get("result")
            if stream.get("bad_response"):
                code, err = 1, f"{err}\nFAILED: {chosen_agent} result response was not a string.".strip()
            elif result is None:
                code, err = 1, f"{err}\nFAILED: {chosen_agent} exited 0 without a result event.".strip()
            elif result.get("status") != "SUCCESS":
                code, err = 1, f"{err}\nFAILED: {chosen_agent} result status {result.get('status')}.".strip()
        return (code, out, err, timed_out), stream

    def _invoke_worker(prompt_text):
        wrapped_task = wrap_prompt_contract(
            prompt_text,
            context_files=context_files,
            output_file=output_file,
            is_thinking=is_thinking,
            verify_cmd=verify_cmd,
            acceptance=opts.get("acceptance"),
        )
        resolved_effort = resolve_agent_effort(chosen_agent, effort, is_thinking=is_thinking)
        cmd = build_agent_command(chosen_agent, chosen_model, wrapped_task, target_dir, output_file=output_file, effort=resolved_effort)
        result, stream = _run_agent(cmd, timeout_seconds)
        if stream is None:
            return result
        cid = stream.get("conversation_id")
        if not (result[3] and cid and not resume_used and os.environ.get("DISPATCH_AGY_RESUME", "1") != "0"):
            return result
        # One automatic resume per job, however many times the worker is re-invoked (verify retry included).
        resume_used.append(cid)
        info["resumed"] = True
        budget = min(max(RESUME_MIN_BUDGET_SECONDS, timeout_seconds / 2), timeout_seconds)
        emit_event("resume", run_id=run_id, agent=chosen_agent, model=chosen_model, conversation_id=cid,
                   reason=info.get("timeout_kind"), budget=budget)
        if log_path:
            try:
                with open(log_path, "a", encoding="utf-8") as log_fh:
                    log_fh.write(f"[Resume] {info.get('timeout_kind')} stall; resuming conversation {cid}\n")
            except OSError:
                pass
        resume_cmd = build_agent_command(chosen_agent, chosen_model, build_resume_prompt(wrapped_task), target_dir,
                                         output_file=output_file, effort=resolved_effort, conversation_id=cid)
        (code, out, err, timed_out), _ = _run_agent(resume_cmd, budget)
        if timed_out:
            err = f"{err}\nFAILED: stalled again after resume; not resuming twice.".strip()
        elif code == 0 and ends_with_question(out):
            code, err = 1, f"{err}\nFAILED: resumed run ended by asking a question instead of finishing.".strip()
        return code, out, err, timed_out

    def _own_exit(code):
        # VERIFY_FAILED_EXIT_CODE is reserved for the dispatcher's verdict, never the worker's own exit status.
        return 1 if code == VERIFY_FAILED_EXIT_CODE else code

    emit_event("start", run_id=run_id, agent=chosen_agent, model=chosen_model, cwd=target_dir, isolated=isolated,
               timeout=timeout_seconds, **verify_event_fields(info), **task_digest(task_text))
    exit_code, stdout, stderr, is_timeout = _invoke_worker(task_text)
    exit_code = _own_exit(exit_code)

    if exit_code == 0 and verify_cmd:
        for attempt in (1, 2):
            if log_path:
                # Keeps the job log moving during a long verify, so --status does not flag it STALLED?.
                try:
                    with open(log_path, "a", encoding="utf-8") as log_fh:
                        log_fh.write(f"[Verify] running: {verify_cmd}\n")
                except OSError:
                    pass
            ok, verify_tail, _verify_timed_out = run_verify_cmd(verify_cmd, target_dir, verify_timeout)
            info.update({"verified": ok, "verify_attempts": attempt, "verify_output": verify_tail})
            if ok:
                break
            if attempt == 1:
                print(f"[Verify] `{verify_cmd}` failed; re-invoking {chosen_agent} once with the failure output.", file=sys.stderr)
                retry_prompt = (
                    f"{task_text.strip()}\n\n"
                    f"VERIFY FAILED: your previous attempt at the task above exited cleanly, but the dispatcher's verify "
                    f"command `{verify_cmd}` failed. Your earlier changes are still in this working tree. Fix the cause "
                    f"(do not weaken, skip, or delete the check), re-run `{verify_cmd}` yourself, and only then finish.\n"
                    f"Last lines of the verify output:\n{verify_tail}"
                )
                exit_code, stdout, stderr, is_timeout = _invoke_worker(retry_prompt)
                exit_code = _own_exit(exit_code)
                if exit_code != 0:
                    break
        if exit_code == 0 and info["verified"] is not True:
            exit_code = VERIFY_FAILED_EXIT_CODE
            fail_msg = (
                f"VERIFY FAILED: `{verify_cmd}` still failing after 1 retry. Nothing was merged.\n"
                f"--- last {VERIFY_TAIL_LINES} lines of verify output ---\n{info['verify_output']}"
            )
            stderr = f"{stderr}\n{fail_msg}".strip()
            print(fail_msg, file=sys.stderr)
            emit_event("verify_failed", run_id=run_id, agent=chosen_agent, model=chosen_model, verify_cmd=verify_cmd,
                       attempts=info["verify_attempts"])

    files_changed, diff_summary, commit_count = inspect_git_changes(target_dir, initial_head, baseline=baseline)
    artifact_after = _artifact_signature()
    # Only a file this run wrote counts: a non-empty output file that is new or changed since the start.
    info["has_artifact"] = bool(artifact_after and artifact_after[1] > 0 and artifact_after != artifact_before)
    return exit_code, stdout, stderr, files_changed, diff_summary


def parse_batch_tasks(batch_args=None, batch_file=None):
    tasks = []
    if batch_file:
        bf = Path(batch_file)
        if not bf.is_file():
            raise FileNotFoundError(f"Batch file not found: {batch_file}")
        content = bf.read_text(encoding="utf-8").strip()
        if content.startswith("[") or content.startswith("{"):
            parsed = json.loads(content)
            if isinstance(parsed, list):
                for item in parsed:
                    if isinstance(item, str) and item.strip():
                        tasks.append({"task": item.strip()})
                    elif isinstance(item, dict) and item.get("task"):
                        tasks.append(item)
            elif isinstance(parsed, dict) and parsed.get("tasks"):
                for item in parsed["tasks"]:
                    if isinstance(item, str) and item.strip():
                        tasks.append({"task": item.strip()})
                    elif isinstance(item, dict) and item.get("task"):
                        tasks.append(item)
        else:
            for line in content.splitlines():
                line = line.strip()
                if line and not line.startswith("#"):
                    tasks.append({"task": line})
    if batch_args:
        for t in batch_args:
            if isinstance(t, str) and t.strip():
                tasks.append({"task": t.strip()})
    return tasks


def extract_tasks_from_plan(plan_path, target_phase=None):
    """
    Extracts task descriptions from a markdown plan file (e.g. docs/superpowers/plans/... or plan.md).
    Supports filtering by phase header (e.g. target_phase=1 or 'Phase 1').
    """
    p = Path(plan_path)
    if not p.is_file():
        raise FileNotFoundError(f"Plan file not found: {plan_path}")
    text = p.read_text(encoding="utf-8")
    lines = text.splitlines()

    selected_lines = []
    if target_phase:
        norm_phase = str(target_phase).lower().replace("phase", "").strip()
        in_phase = False
        for line in lines:
            lower = line.lower()
            if ("phase " in lower or "phase-" in lower) and any(line.lstrip().startswith(h) for h in ("##", "###", "####")):
                phase_match = (
                    f"phase {norm_phase}" in lower
                    or f"phase-{norm_phase}" in lower
                    or f"phase {str(target_phase).lower()}" in lower
                )
                if phase_match:
                    in_phase = True
                elif in_phase:
                    break
            if in_phase:
                selected_lines.append(line)
    else:
        selected_lines = lines

    extracted = []
    for line in selected_lines:
        line_s = line.strip()
        # Extract checkboxes: - [ ] Task ... or - [ ] ...
        if line_s.startswith("- [ ]") or line_s.startswith("- [x]"):
            task_text = line_s[5:].strip()
            if task_text:
                extracted.append({"task": task_text, "context_files": [str(p)]})
        elif (line_s.startswith("### Task") or line_s.startswith("#### Task")) and ":" in line_s:
            task_text = line_s.split(":", 1)[1].strip()
            if task_text:
                extracted.append({"task": task_text, "context_files": [str(p)]})

    return extracted


def batch_overall_exit(results):
    """0 when every task succeeded; VERIFY_FAILED_EXIT_CODE when verify failures are the only failures; else 1."""
    failures = [r.get("exit_code") for r in results if r.get("exit_code") != 0]
    if not failures:
        return 0
    return VERIFY_FAILED_EXIT_CODE if all(ec == VERIFY_FAILED_EXIT_CODE for ec in failures) else 1


def format_batch_report(results):
    total = len(results)
    succeeded = sum(1 for r in results if r.get("exit_code") == 0)
    failed = total - succeeded
    lines = [
        f"=== BATCH DISPATCH REPORT ({total} tasks: {succeeded} succeeded, {failed} failed) ==="
    ]
    for idx, r in enumerate(results, 1):
        task_preview = r.get("task", "")[:28] + "..." if len(r.get("task", "")) > 28 else r.get("task", "")
        status_icon = "SUCCESS" if r.get("exit_code") == 0 else (
            "VERIFY_FAILED" if r.get("exit_code") == VERIFY_FAILED_EXIT_CODE else "FAILED")
        if r.get("status") in (NO_CHANGES_UNVERIFIED_STATUS, RESUMED_UNVERIFIED_STATUS):
            status_icon = r["status"]
        agent = r.get("agent", "worker").upper()
        fc = r.get("files_changed", 0)
        ds = r.get("diff_summary", "no diff")
        verified = {True: "true", False: "false"}.get(r.get("verified", "skipped"), "skipped")
        lines.append(f"#{idx} [{agent}] {status_icon}: {fc} files ({ds}) verified={verified} - '{task_preview}'")

    failed_tasks = [r.get("task", "") for r in results if r.get("exit_code") != 0 and r.get("task")]
    if failed_tasks and len(lines) < 14:
        sample_task = failed_tasks[0]
        if len(sample_task) > 35:
            sample_task = sample_task[:32] + "..."
        lines.append(f"Retry: dispatch-worker --task \"{sample_task}\"")

    lines.append("==================================================")
    return "\n".join(lines[:15])


def format_status_report(jobs):
    if not jobs:
        return "No dispatch jobs found."
    lines = [
        f"=== DISPATCH JOBS STATUS ({len(jobs)} total) ==="
    ]
    for j in jobs[-12:]:
        jid = j.get("job_id", "unknown")
        agent = j.get("agent", "worker").upper()
        status = j.get("status", "UNKNOWN")
        pid = j.get("pid")
        if status == "RUNNING" and pid:
            if not is_pid_running(pid):
                status = "FAILED_DIED"
        fc = j.get("files_changed", 0)
        ds = j.get("diff_summary", "")
        created = j.get("created_at", 0)
        elapsed = int(time.time() - created) if created else 0
        shared = " shared" if j.get("files_changed_shared") else ""
        diff_str = f" | {fc} files{shared} ({ds})" if fc > 0 else ""

        tail_snippet = ""
        log_file = j.get("log_file")
        if log_file and os.path.isfile(log_file) and status == "RUNNING":
            try:
                with open(log_file, "r", encoding="utf-8", errors="replace") as lf:
                    content_lines = [l.strip() for l in lf.readlines() if l.strip()]
                    if content_lines:
                        last_l = content_lines[-1]
                        if len(last_l) > 28:
                            last_l = last_l[:25] + "..."
                        tail_snippet = f" | tail: {last_l}"
                silent = max(0, int(time.time() - os.path.getmtime(log_file)))
                tail_snippet += f" | last output {silent}s ago"
                if silent > STALL_SECONDS:
                    tail_snippet += " STALLED?"
            except Exception:
                pass

        lines.append(f"[{jid}] {agent} | {status} | elapsed={elapsed}s{diff_str}{tail_snippet}")
    lines.append("===============================================")
    return "\n".join(lines[:15])


def load_events(path=None):
    """Reads the event log, skipping blank, malformed, or non-object lines."""
    path = path or os.environ.get("DISPATCH_EVENTS_FILE") or DEFAULT_EVENTS_FILE
    events = []
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if isinstance(rec, dict):
                    events.append(rec)
    except OSError:
        pass
    return events


def format_stats_report(events, days=7, now=None):
    """One-screen per-agent summary of the last `days` days of events."""
    cutoff = (now or time.time()) - days * 86400
    rows = {}

    def _row(agent):
        return rows.setdefault(agent or "unknown", {"starts": 0, "finishes": 0, "ok": 0, "timeouts": 0,
                                                     "fallbacks": 0, "verify_failed": 0, "durations": []})

    for e in events:
        ts = e.get("ts")
        if not isinstance(ts, (int, float)) or ts < cutoff:
            continue
        kind = e.get("event")
        if kind == "start":
            _row(e.get("agent"))["starts"] += 1
        elif kind == "finish":
            r = _row(e.get("agent"))
            r["finishes"] += 1
            r["ok"] += e.get("status") == "SUCCESS"
            if isinstance(e.get("duration_s"), (int, float)):
                r["durations"].append(e["duration_s"])
        elif kind in ("timeout", "idle_timeout"):
            _row(e.get("agent"))["timeouts"] += 1
        elif kind == "verify_failed":
            _row(e.get("agent"))["verify_failed"] += 1
        elif kind == "fallback":
            _row(e.get("from_agent"))["fallbacks"] += 1

    if not rows:
        return f"No dispatch events in the last {days:g} day(s)."
    lines = [f"=== DISPATCH STATS (last {days:g}d) ===",
             f"{'AGENT':<8} {'RUNS':>5} {'OK%':>5} {'TIMEOUT':>8} {'FALLBACK':>9} {'VERIFY_FAIL':>12} {'MEDIAN':>7}"]
    for agent, r in sorted(rows.items(), key=lambda kv: -max(kv[1]["starts"], kv[1]["finishes"]))[:12]:
        runs = max(r["starts"], r["finishes"])
        ok_pct = f"{round(100 * r['ok'] / runs)}%" if runs else "-"
        median_str = f"{statistics.median(r['durations']):.0f}s" if r["durations"] else "-"
        lines.append(f"{agent:<8} {runs:>5} {ok_pct:>5} {r['timeouts']:>8} {r['fallbacks']:>9} {r['verify_failed']:>12} {median_str:>7}")
    return "\n".join(lines)


def tail_job(job_target="latest", num_lines=20, follow=False, job_dir=DEFAULT_JOB_DIR):
    jobs = list_all_jobs(job_dir=job_dir)
    if not jobs:
        print("No dispatch jobs found.", file=sys.stderr)
        sys.exit(1)

    target_job = None
    if not job_target or job_target == "latest":
        sorted_jobs = sorted(jobs, key=lambda j: j.get("created_at", 0), reverse=True)
        target_job = sorted_jobs[0]
    else:
        for j in jobs:
            if j.get("job_id") == job_target:
                target_job = j
                break

    if not target_job:
        print(f"Job '{job_target}' not found.", file=sys.stderr)
        sys.exit(1)

    log_file = target_job.get("log_file")
    if not log_file or not os.path.isfile(log_file):
        print(f"No log file found for job {target_job.get('job_id')}.", file=sys.stderr)
        sys.exit(1)

    jid = target_job.get("job_id")
    status = target_job.get("status", "UNKNOWN")
    print(f"=== TAIL LOG: {jid} ({status}) [{log_file}] ===")

    with open(log_file, "r", encoding="utf-8", errors="replace") as f:
        all_lines = f.readlines()
        for l in all_lines[-num_lines:]:
            sys.stdout.write(l)
        sys.stdout.flush()

        if follow:
            while True:
                line = f.readline()
                if line:
                    sys.stdout.write(line)
                    sys.stdout.flush()
                else:
                    st = load_job_state(jid, job_dir=job_dir)
                    if st and st.get("status") not in ("RUNNING", "PENDING"):
                        break
                    time.sleep(0.5)


def run_internal_job(job_id, job_dir=DEFAULT_JOB_DIR):
    state = load_job_state(job_id, job_dir)
    if not state:
        print(f"FAILED: Job {job_id} not found", file=sys.stderr)
        sys.exit(1)

    cwd = state.get("cwd", os.getcwd())
    task = state.get("task", "")
    agent = state.get("agent", "auto")
    model = state.get("model", None)
    effort = state.get("effort", None)
    timeout = state.get("timeout", DEFAULT_TIMEOUT)
    isolated = state.get("isolated", False)

    context_files = state.get("context_files")
    output_file = state.get("output_file")
    is_thinking = state.get("is_thinking", False)

    state["status"] = "RUNNING"
    state["pid"] = os.getpid()
    save_job_state(job_id, state, job_dir)
    started = time.time()

    verify_info = {}
    shared = bool(not isolated and sharing_jobs(job_id, cwd, float("inf"), job_dir))

    def _save_conversation(cid):
        save_conversation_id(job_id, cid, job_dir)

    def _execute(target_dir):
        return run_single_task(
            task, target_dir, agent, model, timeout,
            context_files=context_files, output_file=output_file, is_thinking=is_thinking,
            verify_opts=verify_opts_from(state), verify_info=verify_info, effort=effort,
            run_id=job_id, isolated=isolated, log_path=state.get("log_file"), on_conversation_id=_save_conversation,
        )

    try:
        if isolated:
            exit_code, stdout, stderr, files_changed, diff_summary = execute_in_isolated_worktree(cwd, _execute)
        else:
            exit_code, stdout, stderr, files_changed, diff_summary = _execute(cwd)
    except Exception as e:
        exit_code, stdout, stderr, files_changed, diff_summary = 1, "", f"Execution error: {e}", 0, "error"

    status = derive_status(exit_code, files_changed, verify_info)
    shared = shared or bool(not isolated and sharing_jobs(job_id, cwd, started, job_dir))

    tail_output = stdout if stdout else (stderr or "none")
    if status == "VERIFY_FAILED":
        tail_output = stderr or tail_output
    state["status"] = status
    state["resumed"] = bool(verify_info.get("resumed"))
    state["conversation_id"] = verify_info.get("conversation_id") or state.get("conversation_id")
    state["files_changed_shared"] = shared
    state["baseline_unavailable"] = bool(verify_info.get("baseline_unavailable"))
    state["verified"] = verify_info.get("verified", "skipped")
    state["verify_cmd"] = verify_info.get("verify_cmd")
    state["verify_output"] = verify_info.get("verify_output", "")
    if status == "VERIFY_FAILED" and isolated:
        state["worktree"] = verify_info.get("worktree")
    state["exit_code"] = exit_code
    state["files_changed"] = files_changed
    state["diff_summary"] = diff_summary
    state["tail_output"] = tail_output[-2000:] if tail_output else ""
    state["completed_at"] = time.time()
    save_job_state(job_id, state, job_dir)
    emit_event("finish", run_id=job_id, agent=agent, model=model, status=status, exit_code=exit_code,
               duration_s=round(time.time() - started, 1), files_changed=files_changed,
               conversation_id=state.get("conversation_id"), resumed=state["resumed"],
               files_changed_shared=shared, **verify_event_fields(verify_info))

    sys.exit(exit_code)


def sharing_jobs(job_id, cwd, since, job_dir=DEFAULT_JOB_DIR):
    """Other non-isolated jobs on the same folder that were running at any point since `since`."""
    here = os.path.realpath(cwd)
    found = []
    for j in list_all_jobs(job_dir=job_dir):
        if j.get("job_id") == job_id or j.get("isolated") or os.path.realpath(j.get("cwd") or "") != here:
            continue
        if j.get("status") == "RUNNING" and is_pid_running(j.get("pid") or 0):
            found.append(j["job_id"])
        elif (j.get("completed_at") or 0) >= since:
            found.append(j["job_id"])
    return found


def spawn_detached_process(job_id, cwd, log_file, job_dir=DEFAULT_JOB_DIR, script_path=None):
    sp = script_path or os.path.abspath(sys.argv[0])
    log_path = Path(log_file)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with open(log_path, "a", encoding="utf-8") as lf:
        proc = subprocess.Popen(
            [sys.executable, sp, "--internal-run-job", job_id, "--job-dir", job_dir],
            cwd=cwd,
            stdout=lf,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            close_fds=True,
        )
    return proc.pid


def execute_batch_parallel(tasks, base_repo_dir, chosen_agent, chosen_model, timeout_seconds, max_parallel=4, chosen_effort=None,
                           run_id=None):
    results = [None] * len(tasks)
    merge_lock = threading.Lock()
    batch_run_id = run_id or new_run_id()

    def _run_task_item(idx, item):
        t_task = item.get("task", "")
        t_cwd = item.get("cwd") or base_repo_dir
        t_agent = item.get("agent") or chosen_agent
        t_model = item.get("model") or chosen_model
        t_effort = item.get("effort") or chosen_effort
        t_timeout = item.get("timeout") or timeout_seconds
        t_context_files = item.get("context_files")
        t_output_file = item.get("output_file")
        t_is_thinking = item.get("is_thinking", False)
        t_verify_info = {}
        t_run_id = f"{batch_run_id}-{idx + 1}"
        t_started = time.time()

        def _execute(target_dir):
            return run_single_task(
                t_task, target_dir, t_agent, t_model, t_timeout,
                context_files=t_context_files, output_file=t_output_file, is_thinking=t_is_thinking,
                verify_opts=verify_opts_from(item), verify_info=t_verify_info, effort=t_effort,
                run_id=t_run_id, isolated=True,
            )

        try:
            exit_code, stdout, stderr, files_changed, diff_summary = execute_in_isolated_worktree(
                t_cwd, _execute, merge_lock=merge_lock
            )
        except Exception as e:
            exit_code, stdout, stderr, files_changed, diff_summary = 1, "", str(e), 0, "error"
        t_status = derive_status(exit_code, files_changed, t_verify_info)
        emit_event("finish", run_id=t_run_id, agent=t_agent, model=t_model, status=t_status,
                   exit_code=exit_code, duration_s=round(time.time() - t_started, 1), files_changed=files_changed,
                   **verify_event_fields(t_verify_info))

        results[idx] = {
            "task": t_task,
            "agent": t_agent,
            "model": t_model,
            "status": t_status,
            "exit_code": exit_code,
            "files_changed": files_changed,
            "diff_summary": diff_summary,
            "tail_output": (stderr or stdout or "none") if exit_code == VERIFY_FAILED_EXIT_CODE else (stdout if stdout else (stderr or "none")),
            "verified": t_verify_info.get("verified", "skipped"),
            "verify_cmd": t_verify_info.get("verify_cmd"),
        }

    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, min(len(tasks), max_parallel))) as executor:
        futures = [executor.submit(_run_task_item, idx, item) for idx, item in enumerate(tasks)]
        concurrent.futures.wait(futures)

    return results


def main():
    default_agent = detect_default_agent(sys.argv[0])
    cfg = load_dispatch_config()
    default_preference = get_config_preference(cfg)
    default_mode_str, default_on_demand = get_config_mode(cfg)
    default_timeout = get_config_timeout(cfg)

    parser = argparse.ArgumentParser(description="Dispatch task to Antigravity CLI, Cursor, or claude -p with quota check.")
    # A disabled agent stays a parseable choice so it gets the "is disabled" refusal below, not an argparse error.
    agent_choices = ["agy", "codex", "cursor", "claude", "auto"]
    parser.add_argument("--agent", choices=agent_choices, default=None,
                        metavar="{" + ",".join(a for a in agent_choices if a not in DISABLED_AGENTS) + "}",
                        help=f"External agent to dispatch to (default: {default_agent}); 'claude' runs `claude -p`")
    parser.add_argument("--model", type=str, default=None,
                        help="Model override for the chosen agent")
    parser.add_argument("--effort", type=str, default=None,
                        help="Reasoning effort level (e.g. low, medium, high, max). Thinking mode defaults to 'medium'.")
    parser.add_argument("--priority", type=str, default=default_preference,
                        help="Priority chain preference (e.g. 'cursor:gemini-3.8-flash > agy')")
    parser.add_argument("--mode", choices=["subscription_quota_remaining", "on_demand"], default=default_mode_str,
                        help="Dispatch mode: 'subscription_quota_remaining' (flat quota) or 'on_demand'")
    parser.add_argument("--allow-on-demand", action="store_true", default=default_on_demand,
                        help="Allow metered on-demand providers (alias for --mode on_demand)")
    parser.add_argument("--check-quota", action="store_true", help="Check quota and exit (0=healthy, 1=low/error)")
    parser.add_argument("--task", type=str, help="Task prompt for external worker")
    parser.add_argument("--batch", nargs="+", help="Multiple task prompts to run in parallel")
    parser.add_argument("--batch-file", type=str, help="JSON or text file containing list of tasks to run in parallel")
    parser.add_argument("--max-parallel", type=int, default=4, help="Max concurrent workers in batch mode (default: 4)")
    parser.add_argument("--detach", "--async", dest="detach", action="store_true", help="Launch task in background and exit immediately")
    parser.add_argument("--status", type=str, nargs="?", const="all", help="Check status of background job(s)")
    parser.add_argument("--wait", type=str, nargs="?", const="all", help="Wait for background job(s) to finish")
    parser.add_argument("--wait-timeout", type=float, default=None, metavar="SECONDS",
                        help=f"Stop a --wait after SECONDS and exit {WAIT_STILL_RUNNING_EXIT_CODE} if the job is still running "
                             f"(default: wait until it finishes; an explicit --timeout is used as this limit)")
    parser.add_argument("--stats", type=float, nargs="?", const=7.0, default=None, metavar="DAYS",
                        help="Per-agent summary of the event log over the last DAYS days (default: 7)")
    parser.add_argument("--tail", type=str, nargs="?", const="latest", help="Show recent log output for a job (default: latest)")
    parser.add_argument("-n", "--lines", type=int, default=20, help="Number of lines to show with --tail (default: 20)")
    parser.add_argument("-f", "--follow", action="store_true", help="Follow log output in real-time (like tail -f)")
    parser.add_argument("--from-plan", type=str, help="Extract tasks from a markdown plan file (e.g. plan.md)")
    parser.add_argument("--phase", type=str, default=None, help="Phase to extract from plan (e.g. 1 or 'Phase 1')")
    parser.add_argument("--cwd", type=str, default=os.getcwd(), help="Target working directory / worktree")
    parser.add_argument("--min-5h", type=float, default=DEFAULT_MIN_5H, help="Minimum 5h quota remaining percent")
    parser.add_argument("--min-weekly", type=float, default=DEFAULT_MIN_WEEKLY, help="Minimum weekly quota remaining percent")
    parser.add_argument("--timeout", type=int, default=None,
                        help=f"Timeout in seconds for execution (default: {default_timeout}s). An agy run killed for idling or "
                             f"timing out is resumed once with min(max(900, timeout/2), timeout) seconds, so the job "
                             f"waits at most 2x this value")
    parser.add_argument("--state-file", type=str, default=None, help="Explicit path to quota observation file")
    parser.add_argument("--job-dir", type=str, default=DEFAULT_JOB_DIR, help="Directory for background job state files")
    parser.add_argument("--dry-run", action="store_true", help="Verify quota and parameters without invoking agent")
    parser.add_argument("--escalate", action="store_true",
                        help="Escalate implementation task from default 3.8-flash worker tier to frontier gemini-4-argon")
    parser.add_argument("--think", action="store_true", help="Heavy thinking mode: Frontier models (Claude Opus 5.5 or Gemini 4 Argon)")
    parser.add_argument("--capability", type=str, default=None, choices=["deep-design-v1"],
                        help="Enforce capability contract (e.g. 'deep-design-v1' restricts models to Frontier thinkers: Claude Opus 5.5 or Gemini 4 Argon and fails closed with exit code 12)")
    parser.add_argument("--attestation-file", type=str, default=None, help="Explicit path to write Thinker attestation JSON (.thinker.json)")
    parser.add_argument("--context", nargs="+", dest="context_files", help="Paths to context/reference files or directories")
    parser.add_argument("--output-file", type=str, default=None, help="File path where worker must write primary deliverable")
    parser.add_argument("--isolated", action="store_true", help="Execute inside a temporary isolated git worktree")
    verify_group = parser.add_mutually_exclusive_group()
    verify_group.add_argument("--verify-cmd", type=str, default=None,
                              help=f"Shell command run inside the worker's worktree after the worker exits 0 and BEFORE any merge. "
                                   f"Default: ./{DEFAULT_VERIFY_SCRIPT} when present and executable")
    verify_group.add_argument("--no-verify", action="store_true", help="Explicitly skip the verify step (result reported as verified: skipped)")
    parser.add_argument("--verify-timeout", type=int, default=DEFAULT_VERIFY_TIMEOUT,
                        help=f"Verify command timeout in seconds; a timeout counts as failure (default: {DEFAULT_VERIFY_TIMEOUT})")
    acceptance_group = parser.add_mutually_exclusive_group()
    acceptance_group.add_argument("--acceptance", type=str, default=None, help="Acceptance criteria text added to the worker prompt contract")
    acceptance_group.add_argument("--acceptance-file", type=str, default=None, help="File holding the acceptance criteria")
    parser.add_argument("--internal-run-job", type=str, default=None, help=argparse.SUPPRESS)

    args = parser.parse_args()
    # The run-timeout default must never end a --wait; only a limit the caller typed does.
    wait_limit = args.wait_timeout if args.wait_timeout is not None else args.timeout
    if args.timeout is None:
        args.timeout = default_timeout
    # Explicit --agent (any spelling: `--agent X`, `--agent=X`) vs the default derived from the program name.
    agent_explicit = args.agent is not None
    if not agent_explicit:
        args.agent = default_agent

    # 1. Internal runner invocation
    if args.internal_run_job:
        run_internal_job(args.internal_run_job, job_dir=args.job_dir)

    # 1a. Event log summary
    if args.stats is not None:
        print(format_stats_report(load_events(), days=args.stats))
        sys.exit(0)

    # 1b. Tail job log
    if args.tail:
        tail_job(args.tail, num_lines=args.lines, follow=args.follow, job_dir=args.job_dir)
        sys.exit(0)

    # 2. Check status of job(s)
    if args.status:
        if args.status == "all":
            jobs = list_all_jobs(job_dir=args.job_dir)
            print(format_status_report(jobs))
            sys.exit(0)
        else:
            state = load_job_state(args.status, job_dir=args.job_dir)
            if not state:
                print(f"Job '{args.status}' not found.", file=sys.stderr)
                sys.exit(1)
            print(format_status_report([state]))
            sys.exit(0)

    # 3. Wait for job(s)
    if args.wait:
        target_ids = []
        if args.wait == "all":
            all_jobs = list_all_jobs(job_dir=args.job_dir)
            active = [j for j in all_jobs if j.get("status") in ("RUNNING", "PENDING")]
            target_ids = [j["job_id"] for j in active]
            if not target_ids:
                print("No running jobs to wait for.")
                sys.exit(0)
        else:
            target_ids = [args.wait]

        start_time = time.time()
        completed_results = {}
        while True:
            all_done = True
            for jid in target_ids:
                st = load_job_state(jid, job_dir=args.job_dir)
                if not st:
                    completed_results[jid] = {"exit_code": 1, "status": "NOT_FOUND"}
                    continue
                status = st.get("status")
                pid = st.get("pid")
                if status in ("RUNNING", "PENDING"):
                    orphaned = not pid and (time.time() - (st.get("created_at") or 0)) > WAIT_ORPHAN_GRACE_SECONDS
                    if orphaned or (pid and not is_pid_running(pid)):
                        st["status"] = "FAILED_DIED"
                        st["exit_code"] = 1
                        save_job_state(jid, st, job_dir=args.job_dir)
                        completed_results[jid] = st
                    else:
                        all_done = False
                else:
                    completed_results[jid] = st

            if all_done or (wait_limit is not None and (time.time() - start_time) > wait_limit):
                break
            time.sleep(0.5)

        still_running = [jid for jid in target_ids if jid not in completed_results]
        if still_running:
            finished = [completed_results[jid] for jid in target_ids if jid in completed_results]
            if finished:
                print(format_batch_report(finished))
            waited = int(time.time() - start_time)
            for jid in still_running:
                print(f"STILL_RUNNING: {jid} has not finished after {waited}s of waiting; the job was not stopped. "
                      f"Wait again: dispatch-worker --wait {jid}")
            sys.exit(WAIT_STILL_RUNNING_EXIT_CODE)

        if len(target_ids) == 1:
            res = completed_results.get(target_ids[0], {})
            ec = res.get("exit_code", 1)
            rep = format_report(
                res.get("agent", args.agent),
                res.get("status", "UNKNOWN"),
                ec,
                res.get("cwd", args.cwd),
                res.get("files_changed", 0),
                res.get("diff_summary", ""),
                res.get("tail_output", ""),
                artifact=res.get("output_file"),
                context_count=len(res.get("context_files") or []),
                verify_info=res,
            )
            print(rep)
            sys.exit(ec if ec is not None else 1)
        else:
            results_list = [completed_results.get(jid, {"task": jid, "agent": args.agent, "exit_code": 1, "files_changed": 0, "diff_summary": "error"}) for jid in target_ids]
            print(format_batch_report(results_list))
            sys.exit(batch_overall_exit(results_list))

    # 4. Quota check / evaluation
    # (the job-inspection commands above stay usable under a disabled agent's program name)
    if args.agent in DISABLED_AGENTS:
        print(f"FAILED: {args.agent} is disabled: dispatch-worker no longer routes to it. "
              f"Use --agent auto, or one of: {', '.join(a for a in agent_choices if a not in DISABLED_AGENTS and a != 'auto')}.",
              file=sys.stderr)
        sys.exit(2)
    effective_on_demand = args.allow_on_demand or (args.mode == "on_demand")
    chosen_agent = args.agent
    chosen_model = args.model

    if chosen_model and any(fb in chosen_model.lower() for fb in ("fable", "claude-fable")):
        print(f"FAILED: model '{chosen_model}' is strictly forbidden. Use 'claude-opus-5-5' (effort medium) instead.", file=sys.stderr)
        sys.exit(12)

    if args.escalate:
        if chosen_agent in ("auto", "agy"):
            chosen_agent = "agy"
            if not chosen_model:
                chosen_model = DEFAULT_AGY_THINK_MODEL
        elif not chosen_model:
            chosen_model = DEFAULT_AGY_THINK_MODEL

    # If --capability deep-design-v1 or --think is set, adjust thresholds and models
    is_deep_design = (args.capability == "deep-design-v1")
    if is_deep_design:
        args.think = True
        # Capability deep-design-v1 strictly restricts allowed models to Claude Opus 5.5 and Gemini 4 Argon
        ALLOWED_DEEP_DESIGN_MODELS = ["claude-opus-5-5", "opus", "gemini-4-argon", "argon", "gemini-4-argon-thinking"]
        if "codex" not in DISABLED_AGENTS:
            ALLOWED_DEEP_DESIGN_MODELS += ["gpt-5.6-sol", "sol"]
        if chosen_model and chosen_model.lower() not in ALLOWED_DEEP_DESIGN_MODELS:
            print(f"FAILED: capability 'deep-design-v1' strictly forbids model '{chosen_model}'. Allowed models: {ALLOWED_DEEP_DESIGN_MODELS}", file=sys.stderr)
            sys.exit(12)  # Fail-closed: THINKER_UNAVAILABLE / FORBIDDEN_MODEL

    min_5h = args.min_5h
    min_weekly = args.min_weekly
    if args.think:
        if "--min-5h" not in sys.argv:
            min_5h = DEFAULT_THINK_MIN_5H
        if "--min-weekly" not in sys.argv:
            min_weekly = DEFAULT_THINK_MIN_WEEKLY
        # Explicit agents are respected; otherwise route_thinker picks Claude Opus 5.5 / Gemini 4 Argon.
        if chosen_agent == "codex":
            chosen_model = normalize_model_name("codex", chosen_model) if chosen_model else DEFAULT_CODEX_THINK_MODEL
    if chosen_agent == "claude":
        chosen_model = normalize_model_name("claude", chosen_model) or DEFAULT_CLAUDE_THINK_MODEL
    if chosen_agent == "agy" and (args.think or is_deep_design):
        chosen_model = normalize_model_name("agy", chosen_model) or DEFAULT_AGY_THINK_MODEL
    # Strict validation: thinking mode allows only frontier thinking models
    if args.think and chosen_model:
        allowed_think_models = list(CLAUDE_THINK_MODEL_NAMES) + list(AGY_THINK_MODEL_NAMES)
        if "codex" not in DISABLED_AGENTS:
            allowed_think_models += ["gpt-5.6-sol", "sol"]
        if chosen_model.lower() not in allowed_think_models:
            print(f"FAILED: thinking mode strictly forbids model '{chosen_model}'. "
                  f"Allowed models: {allowed_think_models}", file=sys.stderr)
            sys.exit(12)
        if chosen_agent == "claude" and chosen_model.lower() not in CLAUDE_THINK_MODEL_NAMES:
            print(f"FAILED: thinking mode for agent 'claude' strictly forbids model '{chosen_model}'. "
                  f"Allowed models: {list(CLAUDE_THINK_MODEL_NAMES)}", file=sys.stderr)
            sys.exit(12)
        if chosen_agent == "agy" and chosen_model.lower() not in AGY_THINK_MODEL_NAMES:
            print(f"FAILED: thinking mode for agent 'agy' strictly forbids model '{chosen_model}'. "
                  f"Allowed models: {list(AGY_THINK_MODEL_NAMES)}", file=sys.stderr)
            sys.exit(12)

    # Strict priority chain validation under thinking mode
    think_priority = args.priority if "--priority" in sys.argv else os.environ.get("DISPATCH_THINK_PREFERENCE")
    if (args.think or is_deep_design) and think_priority:
        for cand_agent, cand_model in parse_priority_chain(think_priority):
            if cand_agent in DISABLED_AGENTS:
                continue
            if cand_agent == "claude" and cand_model:
                m = normalize_model_name("claude", cand_model)
                if not m or m.lower() not in CLAUDE_THINK_MODEL_NAMES:
                    print(f"FAILED: thinking mode for agent 'claude' strictly forbids model '{cand_model}'. "
                          f"Allowed models: {list(CLAUDE_THINK_MODEL_NAMES)}", file=sys.stderr)
                    sys.exit(12)
            elif cand_agent == "agy" and cand_model:
                m = normalize_model_name("agy", cand_model)
                if not m or m.lower() not in AGY_THINK_MODEL_NAMES:
                    print(f"FAILED: thinking mode for agent 'agy' strictly forbids model '{cand_model}'. "
                          f"Allowed models: {list(AGY_THINK_MODEL_NAMES)}", file=sys.stderr)
                    sys.exit(12)
            elif cand_agent == "codex" and cand_model and "codex" not in DISABLED_AGENTS:
                m = normalize_model_name("codex", cand_model)
                if not m or m.lower() not in ("gpt-5.6-sol", "sol"):
                    print(f"FAILED: thinking mode for agent 'codex' strictly forbids model '{cand_model}'.", file=sys.stderr)
                    sys.exit(12)

    # `--agent auto` spelled out is the same request as no --agent: thinking never routes to an execution agent.
    think_chain = args.think and chosen_agent == "auto"

    chosen_effort = args.effort
    if not chosen_effort:
        if args.think or is_deep_design:
            chosen_effort = DEFAULT_THINK_EFFORT
        else:
            chosen_effort = os.environ.get("DISPATCH_EFFORT")

    eligible = False
    rem_5h, rem_weekly = 0.0, 0.0
    msg = ""
    runtime_fallback = None
    routed_by_dispatcher = False
    chain = None

    if think_chain:
        priority_arg = args.priority if "--priority" in sys.argv else os.environ.get("DISPATCH_THINK_PREFERENCE")
        chosen_agent, chosen_model, eligible, rem_5h, rem_weekly, msg, runtime_fallback = route_thinker(
            model=chosen_model, codex_state_file=args.state_file, agy_state_file=args.state_file,
            min_5h=min_5h, min_weekly=min_weekly, priority=priority_arg,
        )
    elif args.priority and (chosen_agent == "auto" or "--priority" in sys.argv):
        chain, dropped = drop_disabled_agents(parse_priority_chain(args.priority))
        for name in dropped:
            print(f"NOTICE: {name} is disabled; dropped from priority chain '{args.priority}'.", file=sys.stderr)
        if dropped and not chain:
            print(f"FAILED: priority chain '{args.priority}' names only disabled agents; nothing to route to.", file=sys.stderr)
            sys.exit(2)
        routed_by_dispatcher = True
        if chain:
            chosen_agent, routed_model, eligible, rem_5h, rem_weekly, msg = route_priority_chain(
                chain,
                allow_on_demand=effective_on_demand,
                min_5h=min_5h,
                min_weekly=min_weekly,
                agy_state_file=args.state_file if default_agent == "agy" else None,
                codex_state_file=args.state_file if default_agent == "codex" else None,
            )
            if not chosen_model and routed_model:
                chosen_model = routed_model
        else:
            chosen_agent, eligible, rem_5h, rem_weekly, msg = route_best_agent(
                min_5h=min_5h,
                min_weekly=min_weekly,
                agy_state_file=args.state_file if default_agent == "agy" else None,
                codex_state_file=args.state_file if default_agent == "codex" else None,
            )
    elif chosen_agent == "auto":
        routed_by_dispatcher = True
        chosen_agent, eligible, rem_5h, rem_weekly, msg = route_best_agent(
            min_5h=min_5h,
            min_weekly=min_weekly,
            agy_state_file=args.state_file if default_agent == "agy" else None,
            codex_state_file=args.state_file if default_agent == "codex" else None,
        )
    else:
        eligible, rem_5h, rem_weekly, msg = check_quota(chosen_agent, args.state_file, min_5h, min_weekly)

    if args.check_quota:
        if eligible:
            print(f"OK: {msg}")
            sys.exit(0)
        else:
            print(f"QUOTA_LOW: {msg}")
            sys.exit(1)

    is_batch = bool(args.batch or args.batch_file or args.from_plan)
    if not is_batch and not args.task:
        parser.print_help(file=sys.stderr)
        sys.exit(2)

    batch_tasks = []
    if is_batch:
        try:
            if args.from_plan:
                batch_tasks = extract_tasks_from_plan(args.from_plan, args.phase)
            else:
                batch_tasks = parse_batch_tasks(args.batch, args.batch_file)
        except Exception as e:
            print(f"FAILED: error parsing batch tasks: {e}", file=sys.stderr)
            sys.exit(2)
        if not batch_tasks:
            print("FAILED: no valid tasks found for batch dispatch.", file=sys.stderr)
            sys.exit(2)
        for item in batch_tasks:
            if normalize_agent_name(str(item.get("agent") or "")) in DISABLED_AGENTS:
                print(f"FAILED: {item.get('agent')} is disabled: a batch task names it as its agent.", file=sys.stderr)
                sys.exit(2)

    run_id = new_run_id()
    if not args.dry_run:
        emit_event("route", run_id=run_id, agent=chosen_agent, model=chosen_model, eligible=eligible, reason=msg,
                   rem_5h=rem_5h, rem_weekly=rem_weekly, mode=args.mode, think=bool(args.think), batch=is_batch)

    if not eligible:
        if is_deep_design:
            print(f"FAILED: Thinker unavailable for 'deep-design-v1' ({msg}). Refusing fallback to execution model.", file=sys.stderr)
            sys.exit(12)  # Fail closed: THINKER_UNAVAILABLE
        print(f"FALLBACK_INTERNAL: Quota insufficient ({msg}).")
        sys.exit(10)  # exit code 10 signals fallback to Claude internal subagent

    cwd = os.path.abspath(args.cwd)

    acceptance_text = args.acceptance
    if args.acceptance_file:
        try:
            acceptance_text = Path(args.acceptance_file).read_text(encoding="utf-8")
        except OSError as e:
            print(f"FAILED: cannot read --acceptance-file: {e}", file=sys.stderr)
            sys.exit(2)
    if not (acceptance_text and acceptance_text.strip()) and not args.think:
        print("WARNING: no acceptance criteria given (--acceptance / --acceptance-file); the worker only has the task text to judge 'done' by.",
              file=sys.stderr)
    cli_verify_opts = {
        "verify_cmd": args.verify_cmd,
        "no_verify": args.no_verify,
        "verify_timeout": args.verify_timeout,
        "acceptance": acceptance_text,
    }
    planned_verify_cmd, planned_verify_source = resolve_verify_cmd(cwd, args.verify_cmd, args.no_verify)
    verify_plan = planned_verify_cmd or ("skipped (--no-verify)" if planned_verify_source == "disabled" else "UNVERIFIED (no verify command)")

    model_info = ""
    if chosen_model:
        model_info = f" with {chosen_model}"
    elif chosen_agent == "codex":
        model = args.model or DEFAULT_CODEX_MODEL
        model_info = f" with {model}"
    elif args.model:
        model_info = f" with {args.model}"
    effort_info = f" (effort: {chosen_effort})" if chosen_effort else ""

    # Dry-run check
    if args.dry_run:
        if is_batch:
            print(f"DRY_RUN: Quota healthy ({msg}). Would dispatch {len(batch_tasks)} task(s) in parallel to {chosen_agent}{model_info}{effort_info} in {cwd} [isolated worktrees]. Verify: {verify_plan}")
        else:
            iso_str = " [isolated worktree]" if args.isolated else ""
            print(f"DRY_RUN: Quota healthy ({msg}). Would dispatch to {chosen_agent}{model_info}{effort_info} in {cwd}{iso_str}. Verify: {verify_plan}")
        sys.exit(0)

    # Detached / Background mode
    if args.detach:
        if is_batch:
            job_ids = []
            for item in batch_tasks:
                jid = f"dw-{int(time.time())}-{os.urandom(3).hex()}"
                state = {
                    "job_id": jid,
                    "agent": item.get("agent") or chosen_agent,
                    "model": item.get("model") or chosen_model,
                    "effort": item.get("effort") or chosen_effort,
                    "task": item.get("task", ""),
                    "cwd": os.path.abspath(item.get("cwd") or args.cwd),
                    "isolated": True,
                    "timeout": args.timeout,
                    "context_files": item.get("context_files") or args.context_files,
                    "output_file": item.get("output_file") or args.output_file,
                    "is_thinking": item.get("is_thinking", args.think),
                    **{k: (item.get(k) if item.get(k) is not None else v) for k, v in cli_verify_opts.items()},
                    "status": "PENDING",
                    "created_at": time.time(),
                    "log_file": f"{DEFAULT_LOG_DIR}/{jid}.log",
                }
                save_job_state(jid, state, job_dir=args.job_dir)
                pid = spawn_detached_process(jid, state["cwd"], state["log_file"], job_dir=args.job_dir)
                state["pid"] = pid
                save_job_state(jid, state, job_dir=args.job_dir)
                job_ids.append(jid)
            print(f"BATCH_DETACHED: {len(job_ids)} jobs launched in background.")
            for jid in job_ids:
                print(f"  - {jid} (Log: {DEFAULT_LOG_DIR}/{jid}.log)")
            print(f"Check: dispatch-worker --status")
            print(f"Wait:  dispatch-worker --wait all")
            sys.exit(0)
        else:
            jid = run_id
            state = {
                "job_id": jid,
                "agent": chosen_agent,
                "model": chosen_model,
                "effort": chosen_effort,
                "task": args.task,
                "cwd": cwd,
                "isolated": args.isolated,
                "timeout": args.timeout,
                "context_files": args.context_files,
                "output_file": args.output_file,
                "is_thinking": args.think,
                **cli_verify_opts,
                "status": "PENDING",
                "created_at": time.time(),
                "log_file": f"{DEFAULT_LOG_DIR}/{jid}.log",
            }
            save_job_state(jid, state, job_dir=args.job_dir)
            pid = spawn_detached_process(jid, cwd, state["log_file"], job_dir=args.job_dir)
            state["pid"] = pid
            save_job_state(jid, state, job_dir=args.job_dir)
            print(f"JOB_DETACHED: job_id={jid} agent={chosen_agent.upper()} status=RUNNING")
            print(f"Log: {state['log_file']}")
            print(f"Check: dispatch-worker --status {jid}")
            print(f"Wait:  dispatch-worker --wait {jid}")
            sys.exit(0)

    # Synchronous Batch Execution
    if is_batch:
        print(f"Dispatching {len(batch_tasks)} task(s) in parallel to {chosen_agent.upper()}{model_info}{effort_info} in {cwd} ({msg})...")
        # Propagate context_files and is_thinking to batch items if not already present
        for b_item in batch_tasks:
            if "context_files" not in b_item and args.context_files:
                b_item["context_files"] = args.context_files
            if "is_thinking" not in b_item:
                b_item["is_thinking"] = args.think
            if "output_file" not in b_item and args.output_file:
                b_item["output_file"] = args.output_file
            if "effort" not in b_item and chosen_effort:
                b_item["effort"] = chosen_effort
            for v_key, v_val in cli_verify_opts.items():
                if b_item.get(v_key) is None:
                    b_item[v_key] = v_val

        results = execute_batch_parallel(
            batch_tasks,
            base_repo_dir=cwd,
            chosen_agent=chosen_agent,
            chosen_model=chosen_model,
            timeout_seconds=args.timeout,
            max_parallel=args.max_parallel,
            chosen_effort=chosen_effort,
            run_id=run_id,
        )
        report = format_batch_report(results)
        print(report)
        sys.exit(batch_overall_exit(results))

    # Routed execution tasks get the same one-shot runtime fallback as the thinker chain; a pinned --agent never does.
    agent_pinned = agent_explicit and args.agent != "auto"
    if routed_by_dispatcher and not args.think and not agent_pinned:
        runtime_fallback = route_execution_fallback(
            chosen_agent, chain=chain, allow_on_demand=effective_on_demand, min_5h=min_5h, min_weekly=min_weekly,
            agy_state_file=args.state_file if default_agent == "agy" else None,
            codex_state_file=args.state_file if default_agent == "codex" else None,
        )
    fallback_tag = "[Thinker]" if think_chain else "[Fallback]"

    # Synchronous Single Task Execution
    print(f"Dispatching to {chosen_agent.upper()}{model_info}{effort_info} in {cwd} ({msg})...")

    verify_info = {}

    def dispatch_once(agent, model):
        def run_worker_in_target(target_dir):
            return run_single_task(
                args.task, target_dir, agent, model, args.timeout,
                context_files=args.context_files, output_file=args.output_file, is_thinking=args.think,
                verify_opts=cli_verify_opts, verify_info=verify_info, effort=chosen_effort,
                run_id=run_id, isolated=args.isolated,
            )

        if not args.isolated:
            return run_worker_in_target(cwd)
        try:
            return execute_in_isolated_worktree(cwd, run_worker_in_target)
        except Exception as e:
            print(f"FAILED: isolated execution error: {e}", file=sys.stderr)
            emit_event("finish", run_id=run_id, agent=agent, model=model, status="ERROR", exit_code=1,
                       duration_s=round(time.time() - started, 1), files_changed=0)
            sys.exit(1)

    # Non-isolated runs share the user's tree: snapshot it so a failed first thinker's writes are never
    # attributed to the fallback (and never wiped - the tree may hold the user's own uncommitted work).
    output_abs = os.path.abspath(os.path.join(cwd, args.output_file)) if args.output_file else None
    output_preexisted = bool(output_abs and os.path.exists(output_abs))
    pre_status = git_status_entries(cwd) if runtime_fallback else None
    pre_head = git_head(cwd) if runtime_fallback else None

    started = time.time()
    exit_code, stdout, stderr, files_changed, diff_summary = dispatch_once(chosen_agent, chosen_model)
    # VERIFY_FAILED means the worker ran and the task's checks failed: a task problem, not a worker problem.
    if exit_code not in (0, VERIFY_FAILED_EXIT_CODE) and runtime_fallback:
        left = changes_left_behind(cwd, pre_status, ignore_path=output_abs)
        refusal = fallback_refusal(diff_summary, left, git_head(cwd) != pre_head)
        retry = refusal is None
        if refusal:
            print(f"{fallback_tag} {chosen_agent} failed and {refusal}\n{fallback_tag} refusing fallback to "
                  f"{runtime_fallback[0]} in {cwd}.", file=sys.stderr)
        elif output_abs and not output_preexisted and os.path.exists(output_abs):
            os.remove(output_abs)
            print(f"{fallback_tag} discarded {chosen_agent}'s partial output file {args.output_file}.", file=sys.stderr)
        if retry:
            print(f"{fallback_tag} {chosen_agent} ({chosen_model or 'default model'}) exited {exit_code}; falling back once to "
                  f"{runtime_fallback[0]} with {runtime_fallback[1] or 'its default model'}.", file=sys.stderr)
            emit_event("fallback", run_id=run_id, from_agent=chosen_agent, to_agent=runtime_fallback[0],
                       to_model=runtime_fallback[1], exit_code=exit_code, reason="worker_failed")
            chosen_agent, chosen_model = runtime_fallback
            verify_info.clear()
            exit_code, stdout, stderr, files_changed, diff_summary = dispatch_once(chosen_agent, chosen_model)
        elif is_deep_design:
            exit_code = 12  # Fail closed: THINKER_UNAVAILABLE

    status = derive_status(exit_code, files_changed, verify_info)
    emit_event("finish", run_id=run_id, agent=chosen_agent, model=chosen_model, status=status, exit_code=exit_code,
               duration_s=round(time.time() - started, 1), files_changed=files_changed,
               conversation_id=verify_info.get("conversation_id"), resumed=bool(verify_info.get("resumed")),
               **verify_event_fields(verify_info))

    tail_output = stdout if stdout else (stderr or "none")
    if status == "VERIFY_FAILED":
        tail_output = verify_info.get("verify_output") or stderr or tail_output
    report = format_report(
        chosen_agent, status, exit_code, cwd, files_changed, diff_summary, tail_output,
        artifact=args.output_file, context_count=len(args.context_files or []), verify_info=verify_info,
    )
    print(report)

    # Write Thinker attestation if requested or if deep-design-v1 capability succeeded
    if exit_code == 0 and (args.attestation_file or is_deep_design):
        attestation_target = args.attestation_file or (
            os.path.join(cwd, ".thinker.json") if not args.output_file else os.path.splitext(args.output_file)[0] + ".thinker.json"
        )
        try:
            p_hash = hashlib.sha256(args.task.encode("utf-8")).hexdigest() if args.task else ""
            out_hash = ""
            if args.output_file and os.path.isfile(args.output_file):
                out_hash = hashlib.sha256(open(args.output_file, "rb").read()).hexdigest()
            elif stdout:
                out_hash = hashlib.sha256(stdout.encode("utf-8")).hexdigest()

            context_hashes = {}
            if args.context_files:
                for cf in args.context_files:
                    if os.path.isfile(cf):
                        try:
                            context_hashes[cf] = hashlib.sha256(open(cf, "rb").read()).hexdigest()
                        except Exception:
                            pass

            resolved_attestation_effort = resolve_agent_effort(chosen_agent, chosen_effort, is_thinking=args.think)
            attestation_data = {
                "capability": args.capability or "deep-design-v1",
                "model": chosen_model,
                "agent": chosen_agent,
                "effort": resolved_attestation_effort or chosen_effort,
                "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                "prompt_sha256": p_hash,
                "output_sha256": out_hash,
                "context_sha256": context_hashes,
                "exit_code": exit_code,
                "status": "ATTESTED",
            }
            os.makedirs(os.path.dirname(os.path.abspath(attestation_target)), exist_ok=True)
            with open(attestation_target, "w", encoding="utf-8") as af:
                json.dump(attestation_data, af, indent=2)
            print(f"Thinker attestation written to {attestation_target}")
        except Exception as e:
            print(f"Warning: Failed to write thinker attestation: {e}", file=sys.stderr)

    sys.exit(exit_code)


if __name__ == "__main__":
    main()
